Функция УпорядоченныеСтроки(МассивСтрок)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	Для Каждого Значение Из МассивСтрок Цикл
		Таблица.Добавить().Значение = Значение;
	КонецЦикла;
	Таблица.Сортировать("Значение Возр");
	Возврат Таблица.ВыгрузитьКолонку("Значение");

