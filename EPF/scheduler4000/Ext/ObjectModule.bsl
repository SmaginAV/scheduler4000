Функция КарточкаЗадания(ЗаданиеИБ, КартаПодсистем)

	МетаданныеЗадания = ЗаданиеИБ.Метаданные;
	ПодсистемыЗадания = КартаПодсистем.Получить(МетаданныеЗадания.ПолноеИмя());
	Если ПодсистемыЗадания = Неопределено Тогда
		ПодсистемыЗадания = Новый Массив;
	КонецЕсли;
	ПодсистемыЗадания = УпорядоченныеСтроки(ПодсистемыЗадания);
	ОсновнаяПодсистема = "Без подсистемы";
	Если ПодсистемыЗадания.Количество() > 0 Тогда
		ОсновнаяПодсистема = ПодсистемыЗадания[0];
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("id", Строка(ЗаданиеИБ.УникальныйИдентификатор));
	Результат.Вставить("name", ПредставлениеЗадания(ЗаданиеИБ));
	Результат.Вставить("methodName", МетаданныеЗадания.ИмяМетода);
	Результат.Вставить("subsystem", ОсновнаяПодсистема);
	Результат.Вставить("subsystems", ПодсистемыЗадания);
	Результат.Вставить("enabled", ЗаданиеИБ.Использование);
	Результат.Вставить("pinned", Ложь);
	Результат.Вставить("schedule", РасписаниеДляКонтракта(ЗаданиеИБ.Расписание));
	Результат.Вставить("durationMed", Неопределено);
	Результат.Вставить("durationP95", Неопределено);
	Результат.Вставить("sampleCount", 0);
	Результат.Вставить("historyQuality", "Нет пригодных запусков; полнота истории не подтверждена");
	Результат.Вставить("lastStart", Неопределено);
	Результат.Вставить("lastEnd", Неопределено);
	Результат.Вставить("carryInInterval", Неопределено);
	Результат.Вставить("forecastStatus", "unknown-duration");
	Результат.Вставить("factIntervals", Новый Массив);
	Возврат Результат;

КонецФункции

Процедура СобратьПринадлежностьПодсистемам(Подсистемы, ПутьРодителя, Карта)

	Для Каждого Подсистема Из Подсистемы Цикл
		Путь = Подсистема.Имя;
		Если Не ПустаяСтрока(ПутьРодителя) Тогда
			Путь = ПутьРодителя + "/" + Путь;
		КонецЕсли;
		Для Каждого ЭлементСостава Из Подсистема.Состав Цикл
			ДобавитьВГруппу(Карта, ЭлементСостава.ПолноеИмя(), Путь);
		КонецЦикла;
		СобратьПринадлежностьПодсистемам(Подсистема.Подсистемы, Путь, Карта);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВГруппу(Карта, Ключ, Значение)

	Группа = Карта.Получить(Ключ);
	Если Группа = Неопределено Тогда
		Группа = Новый Массив;
		Карта.Вставить(Ключ, Группа);
	КонецЕсли;
	Если Группа.Найти(Значение) = Неопределено Тогда
		Группа.Добавить(Значение);
	КонецЕсли;

