	Результат.Вставить("endTime", ВремяДляКонтракта(Расписание.ВремяКонца));
	Результат.Вставить("completionTime", ВремяДляКонтракта(Расписание.ВремяЗавершения));
	Результат.Вставить("startTimeSet", ЗначениеЗаполнено(Расписание.ВремяНачала));
	Результат.Вставить("endTimeSet", ЗначениеЗаполнено(Расписание.ВремяКонца));
	Результат.Вставить("completionTimeSet", ЗначениеЗаполнено(Расписание.ВремяЗавершения));
	Результат.Вставить("completionInterval", Расписание.ИнтервалЗавершения);
	Результат.Вставить("repeatPeriod", Расписание.ПериодПовтораВТечениеДня);
	Результат.Вставить("repeatPause", Расписание.ПаузаПовтора);
