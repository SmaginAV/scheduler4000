#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает пакет визуализации и отдельные доверенные оригиналы для серверного снимка.
// Параметры:
//  Параметры - Структура - ИдентификаторФормы, ДатаСимуляции, НачалоПериода,
//   КонецПериода, ИсточникДлительности, РежимДлительности, ФиксированнаяДлительность,
//   ЛимитПотоков и ШагГрафика.
// Возвращаемое значение:
//  Структура - packet (Структура контракта), originals (Соответствие серверных оригиналов).
Функция СобратьДанные(Знач Параметры) Экспорт

	ПроверитьАдминистративныйДоступ();
	ПроверитьПараметрыСбора(Параметры);
	Возврат СобратьДанныеСРазрешеннымДоступом(Параметры);

КонецФункции

// Запускает чтение истории штатной длительной операцией БСП без записи расписаний.
// Параметры:
//  Параметры - Структура - параметры СобратьДанные, включая владельца результата.
//  АдресФайла - Строка - адрес двоичных данных открытой EPF во временном хранилище.
// Возвращаемое значение:
//  Структура - описание длительной операции БСП с адресом серверного результата.
Функция НачатьСборДанныхВФоне(Знач Параметры, Знач АдресФайла) Экспорт

	ПроверитьАдминистративныйДоступ();
	ПроверитьПараметрыСбора(Параметры);
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Файл обработки недоступен для фонового чтения. Переоткройте обработку.";
	КонецЕсли;
	Настройки = ДлительныеОперации.ПараметрыВыполненияВФоне(Параметры.ИдентификаторФормы);
	Настройки.ОжидатьЗавершение = 0;
	Настройки.ЗапуститьВФоне = Истина;
	Настройки.НаименованиеФоновогоЗадания = "scheduler4000: загрузка истории заданий";
	Настройки.ВнешнийОтчетОбработка = ДанныеФайла;
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ВнешняяОбработка.scheduler4000.МодульОбъекта.ВыполнитьСборДанныхВФоне", Параметры, Настройки);

КонецФункции

// Точка входа БСП: готовый снимок остается на сервере до успешного приема формой.
// Параметры:
//  Параметры - Структура - проверяемые параметры СобратьДанные.
//  АдресРезультата - Строка - адрес результата, выделенный БСП для формы владельца.
Процедура ВыполнитьСборДанныхВФоне(Знач Параметры, Знач АдресРезультата) Экспорт

	Параметры.Вставить("СообщатьПрогресс", Истина);
	Снимок = СобратьДанные(Параметры);
	ДлительныеОперации.СообщитьПрогресс(, "Чтение завершено. Передаем данные для построения графиков...");
	ПоместитьВоВременноеХранилище(Новый Структура("Снимок,Параметры", Снимок, Параметры), АдресРезультата);

КонецПроцедуры

// Проверяет ручные правки окон и возвращает копию полного расписания без записи в ИБ.
// Параметры:
//  Расписание - РасписаниеРегламентногоЗадания - исходное расписание формы настройки.
//  Изменения - Массив из Структура - windowId, newStartTime, newRepeatPeriod, newRepeatPause.
// Возвращаемое значение:
//  РасписаниеРегламентногоЗадания - проверенная копия с сохранением календаря и остальных свойств.
Функция РасписаниеСПравкамиОкон(Знач Расписание, Знач Изменения) Экспорт

	ПроверитьАдминистративныйДоступ();
	Если ТипЗнч(Расписание) <> Тип("РасписаниеРегламентногоЗадания")
		Или ТипЗнч(Изменения) <> Тип("Массив") Тогда
		ВызватьИсключение "Ожидались расписание и массив правок окон.";
	КонецЕсли;
	Основа = ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Расписание);
	Копия = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Основа);
	Если Изменения.Количество() > Макс(1, Копия.ДетальныеРасписанияДня.Количество()) Тогда
		ВызватьИсключение "Количество правок превышает количество окон расписания.";
	КонецЕсли;
	ПрименитьПравкиККопии(Копия, Изменения);
	Возврат Копия;

КонецФункции

// Рассчитывает метрики только по переданным пригодным длительностям.
// Параметры:
//  Длительности - Массив - неотрицательные числовые длительности в секундах.
//  СреднееИМаксимум - Булево - Истина для среднего и максимума выбранных образцов;
//   Ложь сохраняет общий расчет медианы и P95 для программного вызова.
// Возвращаемое значение:
//  Структура - durationMed, durationP95 (Число или Неопределено), sampleCount (Число).
Функция МетрикиДлительности(Знач Длительности, Знач СреднееИМаксимум = Ложь) Экспорт

	Выборка = Новый ТаблицаЗначений;
	Выборка.Колонки.Добавить("Длительность", Новый ОписаниеТипов("Число"));
	Для Каждого Длительность Из Длительности Цикл
		Если ТипЗнч(Длительность) = Тип("Число") И Длительность >= 0 Тогда
			Выборка.Добавить().Длительность = Длительность;
		КонецЕсли;
	КонецЦикла;
	Количество = Выборка.Количество();
	Если Количество = 0 Тогда
		Возврат Новый Структура("durationMed,durationP95,sampleCount", Неопределено, Неопределено, 0);
	КонецЕсли;
	Если СреднееИМаксимум Тогда
		Сумма = 0;
		Максимальная = 0;
		Для Каждого Измерение Из Выборка Цикл
			Сумма = Сумма + Измерение.Длительность;
			Максимальная = Макс(Максимальная, Измерение.Длительность);
		КонецЦикла;
		Возврат Новый Структура("durationMed,durationP95,sampleCount", Сумма / Количество, Максимальная, Количество);
	КонецЕсли;
	Выборка.Сортировать("Длительность Возр");
	Середина = Цел(Количество / 2);
	Медиана = Выборка[Середина].Длительность;
	Если Середина * 2 = Количество Тогда
		Медиана = (Выборка[Середина - 1].Длительность + Медиана) / 2;
	КонецЕсли;
	ПоложениеПерцентиля = Количество * 0.95;
	Ранг = Цел(ПоложениеПерцентиля);
	Если Ранг < ПоложениеПерцентиля Тогда
		Ранг = Ранг + 1;
	КонецЕсли;
	Возврат Новый Структура("durationMed,durationP95,sampleCount",
		Медиана, Выборка[Ранг - 1].Длительность, Количество);

КонецФункции

// Представляет все свойства платформенного расписания в контракте HTML.
// Параметры:
//  Расписание - РасписаниеРегламентногоЗадания - исходное полное расписание.
// Возвращаемое значение:
//  Структура - календарь, дневные свойства и окна с идентификаторами текущего снимка.
Функция РасписаниеДляКонтракта(Знач Расписание) Экспорт

	Результат = ОкноДляКонтракта(Расписание, "root");
	Результат.Вставить("startDate", ДатаДляКонтракта(Расписание.ДатаНачала));
	Результат.Вставить("endDate", ДатаДляКонтракта(Расписание.ДатаКонца));
	Результат.Вставить("daysOfWeek", Расписание.ДниНедели);
	Результат.Вставить("months", Расписание.Месяцы);
	Результат.Вставить("repeatDays", Расписание.ПериодПовтораДней);
	Результат.Вставить("repeatWeeks", Расписание.ПериодНедель);
	Результат.Вставить("dayOfMonth", Расписание.ДеньВМесяце);
	Результат.Вставить("weekDayInMonth", Расписание.ДеньНеделиВМесяце);
	Окна = Новый Массив;
	Индекс = 0;
	Для Каждого Окно Из Расписание.ДетальныеРасписанияДня Цикл
		Окна.Добавить(ОкноДляКонтракта(Окно, "daily:" + Формат(Индекс, "ЧГ=0; ЧН=0")));
		Индекс = Индекс + 1;
	КонецЦикла;
	Результат.Вставить("dailySchedules", Окна);
	Возврат Результат;

КонецФункции

// Восстанавливает пары из переданной таблицы ЖР без чтения информационной базы.
// Параметры:
//  События - ТаблицаЗначений - колонки штатной выгрузки журнала регистрации.
//  Смещение - Число - разность времени сервера и времени сеанса в секундах.
// Возвращаемое значение:
//  Структура - intervals (Массив нормализованных интервалов), quality (Структура качества).
Функция НормализоватьСобытияЖурнала(Знач События, Знач Смещение = 0) Экспорт

	Возврат ВосстановитьИнтервалыЖурнала(События, Смещение, Новый Соответствие, Новый Соответствие);

КонецФункции

// Сериализует пакет без выполнения содержимого строк.
// Параметры:
//  Данные - Произвольный - значения, поддержанные записью JSON.
// Возвращаемое значение:
//  Строка - JSON.
Функция ПакетВJSON(Знач Данные) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

// Строит новые полные расписания из доверенных серверных оригиналов без записи.
// Параметры:
//  Снимок - Структура - результат СобратьДанные, сохраненный только на сервере.
//  Запрос - Структура - сообщение применения:
//   * protocolVersion - Число - версия 1.
//   * formSessionId - Строка - идентификатор открытой формы.
//   * snapshotId - Строка - идентификатор доверенного снимка.
//   * revision - Число - текущая ревизия черновика.
//   * requestId - Строка - уникальный идентификатор операции.
//   * event - Строка - applySchedules.
//   * modifiedJobs - Массив из Структура - id задания и windowChanges:
//     * newEnabled - Булево - необязательное новое использование задания.
//     * scheduleToken - Строка - необязательный идентификатор серверного результата
//       подробного редактора; принадлежит тому же заданию, форме и снимку.
//     * windowId - Строка - root либо daily с индексом из снимка.
//     * newStartTime - Строка - время начала ЧЧ:ММ:СС.
//     * newRepeatPeriod - Число - неотрицательные целые секунды.
//     * newRepeatPause - Число - неотрицательные целые секунды.
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ID задания и новое РасписаниеРегламентногоЗадания.
Функция ПодготовитьРасписания(Знач Снимок, Знач Запрос) Экспорт

	ПроверитьАдминистративныйДоступ();
	ПроверитьКонтекстПрименения(Снимок.packet, Запрос);
	Подготовленные = Новый Соответствие;
	Для Каждого Изменение Из Запрос.modifiedJobs Цикл
		ПоляИзменения = "id,windowChanges";
		Если Изменение.Свойство("scheduleToken") Тогда
			ПоляИзменения = ПоляИзменения + ",scheduleToken";
		КонецЕсли;
		Если Изменение.Свойство("newEnabled") Тогда
			ПоляИзменения = ПоляИзменения + ",newEnabled";
			Если ТипЗнч(Изменение.newEnabled) <> Тип("Булево") Тогда
				ВызватьИсключение "Признак включения задания должен быть булевым.";
			КонецЕсли;
		КонецЕсли;
		ПроверитьПоляСтруктуры(Изменение, ПоляИзменения);
		Если ТипЗнч(Изменение.id) <> Тип("Строка") Тогда
			ВызватьИсключение "Идентификатор задания должен быть строкой.";
		КонецЕсли;
		Оригинал = Снимок.originals.Получить(Изменение.id);
		Если Оригинал = Неопределено Или Подготовленные.Получить(Изменение.id) <> Неопределено Тогда
			ВызватьИсключение "Неизвестное или повторяющееся задание в пакете изменений.";
		КонецЕсли;
		Основа = ОсноваИзменяемогоРасписания(Снимок, Изменение, Оригинал);
		Копия = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Основа);
		ПрименитьПравкиККопии(Копия, Изменение.windowChanges);
		Подготовленные.Вставить(Изменение.id, Копия);
	КонецЦикла;
	Возврат Подготовленные;

КонецФункции

// Сохраняет доверенный снимок на время жизни формы; повторная загрузка заменяет прежние данные.
// Параметры:
//  Снимок - Структура - результат СобратьДанные с documentGeneration в packet.
//  ИдентификаторФормы - УникальныйИдентификатор - владелец временного хранилища.
//  ПрежнийАдрес - Строка - адрес снимка этой формы либо пустая строка.
// Возвращаемое значение:
//  Строка - адрес временного хранилища.
Функция СоздатьСерверныйСнимок(Знач Снимок, Знач ИдентификаторФормы, Знач ПрежнийАдрес = "") Экспорт

	ПроверитьАдминистративныйДоступ();
	Если Снимок.packet.formSessionId <> Строка(ИдентификаторФормы) Тогда
		ВызватьИсключение "Снимок не принадлежит открытой форме.";
	КонецЕсли;
	АдресРазмещения = ИдентификаторФормы;
	Если Не ПустаяСтрока(ПрежнийАдрес) Тогда
		СостояниеСнимка(ПрежнийАдрес, ИдентификаторФормы);
		АдресРазмещения = ПрежнийАдрес;
	КонецЕсли;
	Снимок.Вставить("prepared", Новый Соответствие);
	Состояние = Новый Структура("snapshot,draftChanges,requests,activeRequest,optimizing",
		Снимок, Новый Массив, Новый Соответствие, "", Ложь);
	Возврат ПоместитьВоВременноеХранилище(Состояние, АдресРазмещения);

КонецФункции

// Возвращает непредопределенные типы и допустимые источники параметров нового задания.
// Параметры:
//  Адрес - Строка - адрес снимка открытой формы.
//  ИдентификаторФормы - УникальныйИдентификатор - владелец снимка.
// Возвращаемое значение:
//  Структура - types (Массив описаний типов), context (Структура снимка и ревизии).
Функция ВариантыДобавленияЗадания(Знач Адрес, Знач ИдентификаторФормы) Экспорт

	ПроверитьАдминистративныйДоступ();
	Состояние = СостояниеСнимка(Адрес, ИдентификаторФормы);
	Контекст = Новый Структура("revision,snapshotId",
		Состояние.snapshot.packet.revision, Состояние.snapshot.packet.snapshotId);
	ПроверитьКонтекстДобавления(Состояние, Контекст);
	ТипыЗаданий = Новый Массив;
	Для Каждого МетаданныеЗадания Из Метаданные.РегламентныеЗадания Цикл
		Если МетаданныеЗадания.Предопределенное Тогда
			Продолжить;
		КонецЕсли;
		Источники = Новый Массив;
		Для Каждого Карточка Из Состояние.snapshot.packet.jobs Цикл
			Оригинал = Состояние.snapshot.originals.Получить(Карточка.id);
			Если Не ЭтоНовоеЗадание(Оригинал)
				И Оригинал.metadataName = МетаданныеЗадания.ПолноеИмя() Тогда
				Источник = Новый Структура("id,name", Карточка.id, Карточка.name);
				Источники.Добавить(Источник);
			КонецЕсли;
		КонецЦикла;
		ТипыЗаданий.Добавить(Новый Структура("id,name,methodName,key,parameterSources",
			МетаданныеЗадания.Имя, Строка(МетаданныеЗадания), МетаданныеЗадания.ИмяМетода,
			МетаданныеЗадания.Ключ, Источники));
	КонецЦикла;
	Возврат Новый Структура("types,context", ТипыЗаданий, Контекст);

КонецФункции

// Готовит несохраненный экземпляр в доверенном снимке; запись выполняет общее применение.
// Параметры:
//  Адрес - Строка - адрес снимка формы.
//  ИдентификаторФормы - УникальныйИдентификатор - владелец снимка.
//  Описание - Структура - metadataName, name, key, parameterSourceId.
//  Расписание - РасписаниеРегламентногоЗадания - расписание из отдельной формы.
//  Включено - Булево - использование после явного сохранения.
//  Контекст - Структура - snapshotId и revision при открытии карточки.
// Возвращаемое значение:
//  Структура - job (карточка нового задания), jobs (список для выбора основной формы).
Функция ПодготовитьНовоеЗадание(Знач Адрес, Знач ИдентификаторФормы, Знач Описание,
	Знач Расписание, Знач Включено, Знач Контекст) Экспорт

	ПроверитьАдминистративныйДоступ();
	Состояние = СостояниеСнимка(Адрес, ИдентификаторФормы);
	ПроверитьКонтекстДобавления(Состояние, Контекст);
	ПроверитьОписаниеНовогоЗадания(Описание);
	МетаданныеЗадания = Метаданные.НайтиПоПолномуИмени("РегламентноеЗадание." + Описание.metadataName);
	Если МетаданныеЗадания = Неопределено Или МетаданныеЗадания.Предопределенное Тогда
		ВызватьИсключение "Выберите существующий непредопределенный тип задания.";
	КонецЕсли;
	Если ТипЗнч(Расписание) <> Тип("РасписаниеРегламентногоЗадания")
		Или ТипЗнч(Включено) <> Тип("Булево") Тогда
		ВызватьИсключение "Некорректные расписание или активность нового задания.";
	КонецЕсли;
	НовоеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(МетаданныеЗадания);
	НовоеЗадание.Наименование = Описание.name;
	НовоеЗадание.Ключ = Описание.key;
	НовоеЗадание.Использование = Включено;
	НовоеЗадание.Расписание = Расписание;
	Если Не ПустаяСтрока(Описание.parameterSourceId) Тогда
		ОригиналИсточника = Состояние.snapshot.originals.Получить(Описание.parameterSourceId);
		Если ОригиналИсточника = Неопределено Или ЭтоНовоеЗадание(ОригиналИсточника)
			Или ОригиналИсточника.metadataName <> МетаданныеЗадания.ПолноеИмя() Тогда
			ВызватьИсключение "Источник параметров отсутствует в снимке или относится к другому типу.";
		КонецЕсли;
		Источник = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(
			Новый УникальныйИдентификатор(Описание.parameterSourceId));
		Если Источник = Неопределено Или Источник.Метаданные <> МетаданныеЗадания Тогда
			ВызватьИсключение "Источник параметров удален или его тип изменен. Загрузите данные заново.";
		КонецЕсли;
		НовоеЗадание.Параметры = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(Источник.Параметры));
	КонецЕсли;
	Оригинал = ОригиналЗадания(НовоеЗадание);
	Оригинал.Вставить("newJob", ЗначениеВСтрокуВнутр(НовоеЗадание));
	Оригинал.Вставить("newParameters", ЗначениеВСтрокуВнутр(НовоеЗадание.Параметры));
	КартаПодсистем = Новый Соответствие;
	СобратьПринадлежностьПодсистемам(Метаданные.Подсистемы, "", КартаПодсистем);
	Карточка = КарточкаЗадания(НовоеЗадание, КартаПодсистем);
	Карточка.Вставить("isNew", Истина);
	Карточка.Вставить("historyState", "never");
	Состояние.snapshot.originals.Вставить(Карточка.id, Оригинал);
	Состояние.snapshot.packet.jobs.Вставить(0, Карточка);
	ПоместитьВоВременноеХранилище(Состояние, Адрес);
	Возврат Новый Структура("job,jobs", Карточка, Состояние.snapshot.packet.jobs);

КонецФункции

// Проверяет только разрешенные пользовательские поля нового экземпляра.
// Параметры:
//  Описание - Структура - metadataName, name, key, parameterSourceId (Строка).
Процедура ПроверитьОписаниеНовогоЗадания(Знач Описание) Экспорт

	ПроверитьПоляСтруктуры(Описание, "metadataName,name,key,parameterSourceId");
	Для Каждого Поле Из Описание Цикл
		Если ТипЗнч(Поле.Значение) <> Тип("Строка") Или СтрДлина(Поле.Значение) > 1000 Тогда
			ВызватьИсключение "Поля нового задания должны быть строками длиной не более 1000 символов.";
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Описание.metadataName) Или ПустаяСтрока(Описание.name) Тогда
		ВызватьИсключение "Выберите тип и укажите имя нового задания.";
	КонецЕсли;

КонецПроцедуры

// Возвращает полное расписание из черновика для отдельной формы настройки без записи в ИБ.
// Параметры:
//  Адрес - Строка - адрес серверного снимка.
//  ИдентификаторФормы - УникальныйИдентификатор - владелец снимка.
//  ИдентификаторЗадания - Строка - идентификатор задания из снимка.
// Возвращаемое значение:
//  Структура - Расписание (РасписаниеРегламентногоЗадания), Контекст (Структура),
//   Включено (Булево), Наименование (Строка).
Функция ПолучитьРасписаниеДляРедактора(Знач Адрес, Знач ИдентификаторФормы,
	Знач ИдентификаторЗадания) Экспорт

	ПроверитьАдминистративныйДоступ();
	Состояние = СостояниеСнимка(Адрес, ИдентификаторФормы);
	ПроверитьДоступностьРедактора(Состояние, ИдентификаторЗадания, Состояние.snapshot.packet.revision);
	Оригинал = Состояние.snapshot.originals.Получить(ИдентификаторЗадания);
	Расписание = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(Оригинал.schedule);
	Включено = Оригинал.enabled;
	Если Состояние.draftChanges.Количество() > 0 Тогда
		Запрос = ЗапросЧерновика(Состояние);
		Подготовленные = ПодготовитьРасписания(Состояние.snapshot, Запрос);
		Если Подготовленные.Получить(ИдентификаторЗадания) <> Неопределено Тогда
			Расписание = Подготовленные.Получить(ИдентификаторЗадания);
			Включено = ИспользованиеИзПакета(Состояние.snapshot, Запрос).Получить(ИдентификаторЗадания);
		КонецЕсли;
	КонецЕсли;
	Контекст = Новый Структура("revision,snapshotId",
		Состояние.snapshot.packet.revision, Состояние.snapshot.packet.snapshotId);
	Наименование = "";
	Для Каждого Карточка Из Состояние.snapshot.packet.jobs Цикл
		Если Карточка.id = ИдентификаторЗадания Тогда
			Наименование = Карточка.name;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Расписание,Контекст,Включено,Наименование", Расписание, Контекст, Включено, Наименование);

КонецФункции

// Сохраняет результат штатного диалога только в серверном черновике.
// Параметры:
//  Адрес - Строка - адрес серверного снимка.
//  ИдентификаторФормы - УникальныйИдентификатор - владелец снимка.
//  ИдентификаторЗадания - Строка - идентификатор задания из снимка.
//  Расписание - РасписаниеРегламентногоЗадания - результат диалога платформы.
//  Контекст - Структура - revision и snapshotId при открытии диалога.
// Возвращаемое значение:
//  Структура - id, schedule, scheduleToken для обновления модели HTML.
Функция ПодготовитьПодробноеРасписание(Знач Адрес, Знач ИдентификаторФормы,
	Знач ИдентификаторЗадания, Знач Расписание, Знач Контекст) Экспорт

	ПроверитьАдминистративныйДоступ();
	Состояние = СостояниеСнимка(Адрес, ИдентификаторФормы);
	ПроверитьПоляСтруктуры(Контекст, "revision,snapshotId");
	Если Контекст.snapshotId <> Состояние.snapshot.packet.snapshotId Тогда
		ВызватьИсключение "Снимок заменен после открытия редактора.";
	КонецЕсли;
	ПроверитьДоступностьРедактора(Состояние, ИдентификаторЗадания, Контекст.revision);
	Если ТипЗнч(Расписание) <> Тип("РасписаниеРегламентногоЗадания") Тогда
		ВызватьИсключение "Ожидалось расписание регламентного задания.";
	КонецЕсли;
	Основа = ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Расписание);
	ИдентификаторРасписания = Строка(Новый УникальныйИдентификатор);
	Состояние.snapshot.prepared.Вставить(ИдентификаторРасписания,
		Новый Структура("id,schedule", ИдентификаторЗадания, Основа));
	ПоместитьВоВременноеХранилище(Состояние, Адрес);
	Возврат Новый Структура("id,schedule,scheduleToken", ИдентификаторЗадания,
		РасписаниеДляКонтракта(Расписание), ИдентификаторРасписания);

КонецФункции

// Проверяет сообщение HTML и обрабатывает черновик либо явный запрос применения.
// Параметры:
//  Адрес - Строка - серверный адрес снимка этой формы.
//  ИдентификаторФормы - УникальныйИдентификатор - действительный владелец формы.
//  СообщениеJSON - Строка - JSON протокола 1.
// Возвращаемое значение:
//  Структура - status, message, revision, dirty, optimizing; при применении также requestId и packet.
Функция ОбработатьСообщениеСимулятора(Знач Адрес, Знач ИдентификаторФормы, Знач СообщениеJSON) Экспорт

	ПроверитьАдминистративныйДоступ();
	Состояние = СостояниеСнимка(Адрес, ИдентификаторФормы);
	Если ТипЗнч(СообщениеJSON) <> Тип("Строка") Или СтрДлина(СообщениеJSON) > 16777216 Тогда
		ВызватьИсключение "Сообщение моста превышает допустимый размер 16777216 символов.";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СообщениеJSON);
	Сообщение = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ПроверитьОболочкуСообщения(Сообщение, Состояние.snapshot.packet);
	Если Сообщение.event = "applySchedules" Тогда
		Возврат ПрименитьСообщениеРасписаний(Адрес, Состояние, Сообщение);
	КонецЕсли;
	Если Сообщение.snapshotId <> Состояние.snapshot.packet.snapshotId Тогда
		ВызватьИсключение "Документ относится к устаревшему снимку.";
	КонецЕсли;
	КоличествоЗаданий = Состояние.snapshot.packet.jobs.Количество();
	Если Сообщение.event = "draftChanged" Или Сообщение.event = "optimizationFinished" Тогда
		ПринятьЧерновик(Состояние, Сообщение);
	ИначеЕсли Сообщение.event = "ready" Или Сообщение.event = "exportSnapshot"
		Или Сообщение.event = "editSchedule" Или Сообщение.event = "preferencesChanged" Тогда
		Если Сообщение.revision <> Состояние.snapshot.packet.revision Тогда
			ВызватьИсключение "Документ содержит устаревшую ревизию.";
		КонецЕсли;
	Иначе
		ВызватьИсключение "Событие не поддерживается обработчиком снимка.";
	КонецЕсли;
	ПоместитьВоВременноеХранилище(Состояние, Адрес);
	Ответ = ОтветСостояния(Состояние, "accepted", "");
	Если КоличествоЗаданий <> Состояние.snapshot.packet.jobs.Количество() Тогда
		Ответ.Вставить("jobs", Состояние.snapshot.packet.jobs);
	КонецЕсли;
	Если Сообщение.event = "preferencesChanged" Тогда
		Настройки = ПроверитьНастройкиПредставления(ПакетВJSON(Сообщение.preferences));
		Состояние.snapshot.packet.Вставить("preferences", Настройки);
		ПоместитьВоВременноеХранилище(Состояние, Адрес);
		Ответ.status = "preferences";
		Ответ.Вставить("preferences", Настройки);
	КонецЕсли;
	Если Сообщение.event = "exportSnapshot" Тогда
		Ответ.status = "export";
	КонецЕсли;
	Если Сообщение.event = "editSchedule" Тогда
		ПроверитьДоступностьРедактора(Состояние, Сообщение.jobId, Сообщение.revision);
		Ответ.status = "editSchedule";
		Ответ.Вставить("jobId", Сообщение.jobId);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Проверяет сохраняемые параметры представления; расписания в них не передаются.
// Параметры:
//  ТекстJSON - Строка - параметры интерфейса версии 1.
// Возвращаемое значение:
//  Структура - проверенные параметры фильтра, масштаба и закрепления.
Функция ПроверитьНастройкиПредставления(Знач ТекстJSON) Экспорт

	Если ТипЗнч(ТекстJSON) <> Тип("Строка") Или СтрДлина(ТекстJSON) > 1048576 Тогда
		ВызватьИсключение "Недопустимый размер настроек представления.";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Настройки = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ПроверитьПоляСтруктуры(Настройки,
		"enabledOnly,grouping,query,technicalNames,pinnedJobIds,rangeStartSeconds,rangeSpanSeconds");
	Если ТипЗнч(Настройки.enabledOnly) <> Тип("Булево") Или ТипЗнч(Настройки.technicalNames) <> Тип("Булево")
		Или ТипЗнч(Настройки.query) <> Тип("Строка") Или СтрДлина(Настройки.query) > 1000
		Или СтрРазделить("none,subsystem,duration", ",").Найти(Настройки.grouping) = Неопределено Тогда
		ВызватьИсключение "Недопустимые параметры фильтра.";
	КонецЕсли;
	Если ТипЗнч(Настройки.rangeStartSeconds) <> Тип("Число")
		Или ТипЗнч(Настройки.rangeSpanSeconds) <> Тип("Число") Тогда
		ВызватьИсключение "Масштаб времени должен быть числовым.";
	КонецЕсли;
	Если Настройки.rangeStartSeconds < 0 Или Настройки.rangeSpanSeconds < 300
		Или Настройки.rangeStartSeconds + Настройки.rangeSpanSeconds > 86400 Тогда
		ВызватьИсключение "Масштаб времени выходит за границы суток.";
	КонецЕсли;
	Если ТипЗнч(Настройки.pinnedJobIds) <> Тип("Массив") Или Настройки.pinnedJobIds.Количество() > 10000 Тогда
		ВызватьИсключение "Недопустимый список закрепленных заданий.";
	КонецЕсли;
	Для Каждого Идентификатор Из Настройки.pinnedJobIds Цикл
		Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
			ВызватьИсключение "Идентификатор закрепленного задания должен быть строкой UUID.";
		КонецЕсли;
		Если Строка(Новый УникальныйИдентификатор(Идентификатор)) <> Идентификатор Тогда
			ВызватьИсключение "Недопустимый идентификатор закрепленного задания.";
		КонецЕсли;
	КонецЦикла;
	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоНовоеЗадание(Оригинал)

	Возврат Оригинал.Свойство("newJob");

КонецФункции

Процедура ПроверитьКонтекстДобавления(Состояние, Контекст)

	ПроверитьПоляСтруктуры(Контекст, "revision,snapshotId");
	Если Не ПустаяСтрока(Состояние.activeRequest) Или Состояние.optimizing Тогда
		ВызватьИсключение "Дождитесь окончания расчета или сверки записи.";
	КонецЕсли;
	Если Контекст.snapshotId <> Состояние.snapshot.packet.snapshotId
		Или Контекст.revision <> Состояние.snapshot.packet.revision Тогда
		ВызватьИсключение "Черновик изменился. Откройте добавление задания заново.";
	КонецЕсли;

КонецПроцедуры

Функция ОсноваИзменяемогоРасписания(Снимок, Изменение, Оригинал)

	Если Не Изменение.Свойство("scheduleToken") Тогда
		Если Изменение.Свойство("newEnabled") Или ЭтоНовоеЗадание(Оригинал) Тогда
			Если ТипЗнч(Изменение.windowChanges) <> Тип("Массив") Тогда
				ВызватьИсключение "Правки окон должны быть массивом.";
			КонецЕсли;
		Иначе
			ПроверитьНепустыеИзменения(Изменение.windowChanges);
		КонецЕсли;
		Возврат Оригинал.schedule;
	КонецЕсли;
	Если ТипЗнч(Изменение.scheduleToken) <> Тип("Строка") Или Не Снимок.Свойство("prepared") Тогда
		ВызватьИсключение "Неизвестное подробное расписание.";
	КонецЕсли;
	Подробное = Снимок.prepared.Получить(Изменение.scheduleToken);
	Если Подробное = Неопределено Или Подробное.id <> Изменение.id Тогда
		ВызватьИсключение "Подробное расписание принадлежит другому заданию или снимку.";
	КонецЕсли;
	Если ТипЗнч(Изменение.windowChanges) <> Тип("Массив") Тогда
		ВызватьИсключение "Правки окон должны быть массивом.";
	КонецЕсли;
	Возврат Подробное.schedule;

КонецФункции

Процедура ПроверитьДоступностьРедактора(Состояние, ИдентификаторЗадания, Ревизия)

	Если Не ПустаяСтрока(Состояние.activeRequest) Или Состояние.optimizing Тогда
		ВызватьИсключение "Дождитесь окончания расчета или сверки записи.";
	КонецЕсли;
	Если Состояние.snapshot.packet.revision <> Ревизия Тогда
		ВызватьИсключение "Черновик изменился после открытия редактора. Откройте расписание заново.";
	КонецЕсли;
	Если ТипЗнч(ИдентификаторЗадания) <> Тип("Строка")
		Или Состояние.snapshot.originals.Получить(ИдентификаторЗадания) = Неопределено Тогда
		ВызватьИсключение "Задание отсутствует в серверном снимке.";
	КонецЕсли;

КонецПроцедуры

Функция ЗапросЧерновика(Состояние)

	Контекст = Состояние.snapshot.packet;
	Запрос = Новый Структура("protocolVersion,formSessionId,snapshotId,revision,requestId,event,modifiedJobs",
		1, Контекст.formSessionId, Контекст.snapshotId, Контекст.revision,
		Строка(Новый УникальныйИдентификатор), "applySchedules", Состояние.draftChanges);
	Возврат Запрос;

КонецФункции

Функция ПрименитьСообщениеРасписаний(Адрес, Состояние, Сообщение)

	Запрос = ЗапросПримененияИзСообщения(Сообщение);
	Если ТипЗнч(Запрос.requestId) <> Тип("Строка") Тогда
		ВызватьИсключение "Идентификатор применения должен быть строкой.";
	КонецЕсли;
	ОтпечатокЗапроса = ЗначениеВСтрокуВнутр(Запрос);
	Квитанция = Состояние.requests.Получить(Запрос.requestId);
	Если Квитанция <> Неопределено Тогда
		Если Квитанция.requestFingerprint <> ОтпечатокЗапроса Тогда
			ВызватьИсключение "Этот requestId уже использован для другого пакета.";
		КонецЕсли;
		Если Квитанция.status = "uncertain" Или Квитанция.status = "writing" Или Квитанция.status = "committed" Тогда
			СверитьПрименение(Состояние, Квитанция);
			ПоместитьВоВременноеХранилище(Состояние, Адрес);
		КонецЕсли;
		Возврат ОтветПрименения(Состояние, Квитанция);
	КонецЕсли;
	Если Не ПустаяСтрока(Состояние.activeRequest) Или Состояние.optimizing Тогда
		ВызватьИсключение "Сначала завершите расчет или сверьте предыдущее применение.";
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Применение должно выполняться вне другой транзакции.";
	КонецЕсли;
	Подготовленные = ПодготовитьРасписания(Состояние.snapshot, Запрос);
	Использование = ИспользованиеИзПакета(Состояние.snapshot, Запрос);
	Квитанция = КвитанцияПрименения(Состояние.snapshot, Подготовленные, Запрос, ОтпечатокЗапроса, Использование);
	Состояние.requests.Вставить(Запрос.requestId, Квитанция);
	Состояние.activeRequest = Запрос.requestId;
	// Квитанция существует до транзакции; потеря ответа разрешает только сверку, а не повтор записи.
	ПоместитьВоВременноеХранилище(Состояние, Адрес);
	РезультатЗаписи = ЗаписатьПакетРасписаний(Состояние.snapshot, Подготовленные, Использование);
	Квитанция.error = РезультатЗаписи.error;
	Если Не РезультатЗаписи.success И РезультатЗаписи.rolledBack Тогда
		Квитанция.status = "rejected";
		Состояние.activeRequest = "";
	Иначе
		Квитанция.status = "committed";
		Если Не РезультатЗаписи.success Тогда
			Квитанция.status = "uncertain";
		КонецЕсли;
		ПоместитьВоВременноеХранилище(Состояние, Адрес);
		СверитьПрименение(Состояние, Квитанция);
	КонецЕсли;
	ПоместитьВоВременноеХранилище(Состояние, Адрес);
	Возврат ОтветПрименения(Состояние, Квитанция);

КонецФункции

Функция ИспользованиеИзПакета(Снимок, Запрос)

	Результат = Новый Соответствие;
	Для Каждого Изменение Из Запрос.modifiedJobs Цикл
		Оригинал = Снимок.originals.Получить(Изменение.id);
		НовоеИспользование = Оригинал.enabled;
		Если Изменение.Свойство("newEnabled") Тогда
			НовоеИспользование = Изменение.newEnabled;
		КонецЕсли;
		Результат.Вставить(Изменение.id, НовоеИспользование);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КвитанцияПрименения(Снимок, Подготовленные, Запрос, Отпечаток, Использование)

	Ожидаемые = Новый Соответствие;
	Исходные = Новый Соответствие;
	Для Каждого Элемент Из Подготовленные Цикл
		НовоеРасписание = ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Элемент.Значение);
		Ожидаемые.Вставить(Элемент.Ключ, ЗначениеВСтрокуВнутр(НовоеРасписание));
		Исходные.Вставить(Элемент.Ключ, Снимок.originals.Получить(Элемент.Ключ));
	КонецЦикла;
	Возврат Новый Структура("requestId,requestFingerprint,status,expected,originals,error,expectedEnabled",
		Запрос.requestId, Отпечаток, "writing", Ожидаемые, Исходные, "", Использование);

КонецФункции

Функция ИдентификаторыПоПорядку(Данные)

	Идентификаторы = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Идентификаторы.Добавить(Элемент.Ключ);
	КонецЦикла;
	Возврат УпорядоченныеСтроки(Идентификаторы);

КонецФункции

Функция БлокировкаЗаданий(Идентификаторы)

	Блокировка = Новый БлокировкаДанных;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Элемент = Блокировка.Добавить("РегистрСведений.КэшПрограммныхИнтерфейсов");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Идентификатор", Идентификатор);
	КонецЦикла;
	Возврат Блокировка;

КонецФункции

Функция ЗаписатьПакетРасписаний(Снимок, Подготовленные, Использование)

	Идентификаторы = ИдентификаторыПоПорядку(Подготовленные);
	Блокировка = БлокировкаЗаданий(Идентификаторы);
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Прочитанные = Новый Соответствие;
		Для Каждого Идентификатор Из Идентификаторы Цикл
			Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Идентификатор));
			Исходный = Снимок.originals.Получить(Идентификатор);
			Если ЭтоНовоеЗадание(Исходный) Тогда
				Задание = НовоеЗаданиеДляЗаписи(Исходный, Задание);
				Прочитанные.Вставить(Идентификатор, Задание);
				Продолжить;
			КонецЕсли;
			Если Задание = Неопределено Тогда
				ВызватьИсключение "Задание удалено после загрузки: " + Идентификатор;
			КонецЕсли;
			Текущий = ОригиналЗадания(Задание);
			Если Не СовпадаетОригинал(Текущий, Исходный) Тогда
				ВызватьИсключение "Расписание, активность или метод задания изменены другим сеансом: " + Задание.Наименование;
			КонецЕсли;
			Прочитанные.Вставить(Идентификатор, Задание);
		КонецЦикла;
		Для Каждого Идентификатор Из Идентификаторы Цикл
			Задание = Прочитанные.Получить(Идентификатор);
			Задание.Расписание = Подготовленные.Получить(Идентификатор);
			Задание.Использование = Использование.Получить(Идентификатор);
			Задание.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		// Структурированный отказ сохраняет результат отмены для протокола requestId.
		// Если сама отмена недоступна, наружу выйдет ошибка, а квитанция останется для сверки.
		Возврат Новый Структура("success,rolledBack,error", Ложь, Истина, ОписаниеОшибки());
	КонецПопытки;
	Возврат Новый Структура("success,rolledBack,error", Истина, Ложь, "");

КонецФункции

Функция СовпадаетОригинал(Текущий, Исходный)

	Возврат Текущий.fingerprint = Исходный.fingerprint И Текущий.metadataName = Исходный.metadataName
		И Текущий.methodName = Исходный.methodName И Текущий.enabled = Исходный.enabled;

КонецФункции

Функция ПрочитатьЗаданияДляСверки(Ожидаемые)

	Идентификаторы = ИдентификаторыПоПорядку(Ожидаемые);
	Блокировка = БлокировкаЗаданий(Идентификаторы);
	Результат = Новый Соответствие;
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Для Каждого Идентификатор Из Идентификаторы Цикл
			Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Идентификатор));
			Результат.Вставить(Идентификатор, Задание);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура СверитьПрименение(Состояние, Квитанция)

	Попытка
		Прочитанные = ПрочитатьЗаданияДляСверки(Квитанция.expected);
		ВсеНовые = Истина;
		ВсеИсходные = Истина;
		Для Каждого Элемент Из Квитанция.expected Цикл
			Задание = Прочитанные.Получить(Элемент.Ключ);
			Исходный = Квитанция.originals.Получить(Элемент.Ключ);
			Если Задание = Неопределено Тогда
				ВсеНовые = Ложь;
				ВсеИсходные = ВсеИсходные И ЭтоНовоеЗадание(Исходный);
				Продолжить;
			КонецЕсли;
			Текущий = ОригиналЗадания(Задание);
			ВсеИсходные = ВсеИсходные И Не ЭтоНовоеЗадание(Исходный) И СовпадаетОригинал(Текущий, Исходный);
			ВсеНовые = ВсеНовые И Текущий.fingerprint = Элемент.Значение
				И Текущий.enabled = Квитанция.expectedEnabled.Получить(Элемент.Ключ)
				И Текущий.metadataName = Исходный.metadataName И Текущий.methodName = Исходный.methodName;
			Если ЭтоНовоеЗадание(Исходный) Тогда
				Заготовка = ВосстановитьНовоеЗадание(Исходный);
				ВсеНовые = ВсеНовые И ОтпечатокПараметровНовогоЗадания(Задание) = ОтпечатокПараметровНовогоЗадания(Заготовка);
			КонецЕсли;
		КонецЦикла;
		Если ВсеНовые Тогда
			ОбновитьСнимокПослеЗаписи(Состояние, Прочитанные, Квитанция.requestId);
			Квитанция.status = "applied";
			Квитанция.error = "Расписания записаны и подтверждены повторным чтением.";
			Состояние.activeRequest = "";
		ИначеЕсли ВсеИсходные Тогда
			Квитанция.status = "rejected";
			Состояние.activeRequest = "";
			Если ПустаяСтрока(Квитанция.error) Тогда
				Квитанция.error = "Запись не подтверждена; исходные расписания сохранены.";
			КонецЕсли;
		Иначе
			Квитанция.status = "uncertain";
			Квитанция.error = "Результат применения не определен: текущие значения отличаются. Повторная запись не выполнялась.";
		КонецЕсли;
	Исключение
		Квитанция.status = "uncertain";
		Квитанция.error = "Не удалось сверить результат применения: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

Функция ОтпечатокПараметровНовогоЗадания(Задание)

	Данные = Новый Структура("Наименование,Ключ,Параметры,ИмяПользователя,"
		+ "ИнтервалПовтораПриАварийномЗавершении,КоличествоПовторовПриАварийномЗавершении");
	ЗаполнитьЗначенияСвойств(Данные, Задание);
	Возврат ЗначениеВСтрокуВнутр(Данные);

КонецФункции

Функция ВосстановитьНовоеЗадание(Исходный)

	Задание = ЗначениеИзСтрокиВнутр(Исходный.newJob);
	// На 8.3.27 восстановление самого задания дополняет массив параметров Неопределено.
	// Точный состав сохраняется отдельно от сериализованного объекта с его UUID.
	Задание.Параметры = ЗначениеИзСтрокиВнутр(Исходный.newParameters);
	Возврат Задание;

КонецФункции

Функция НовоеЗаданиеДляЗаписи(Исходный, ТекущееЗадание)

	Если ТекущееЗадание <> Неопределено Тогда
		ВызватьИсключение "Новый экземпляр уже существует. Требуется сверка результата записи.";
	КонецЕсли;
	МетаданныеЗадания = Метаданные.НайтиПоПолномуИмени(Исходный.metadataName);
	Если МетаданныеЗадания = Неопределено Или МетаданныеЗадания.Предопределенное
		Или МетаданныеЗадания.ИмяМетода <> Исходный.methodName Тогда
		ВызватьИсключение "Тип или метод нового задания изменен после подготовки.";
	КонецЕсли;
	Возврат ВосстановитьНовоеЗадание(Исходный);

КонецФункции

Процедура ОбновитьСнимокПослеЗаписи(Состояние, Прочитанные, ИдентификаторЗапроса)

	НовыйСнимок = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(Состояние.snapshot));
	Для Каждого Карточка Из НовыйСнимок.packet.jobs Цикл
		Задание = Прочитанные.Получить(Карточка.id);
		Если Задание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Карточка.schedule = РасписаниеДляКонтракта(Задание.Расписание);
		Карточка.enabled = Задание.Использование;
		Карточка.name = ПредставлениеЗадания(Задание);
		Карточка.Удалить("isNew");
		НовыйСнимок.originals.Вставить(Карточка.id, ОригиналЗадания(Задание));
	КонецЦикла;
	НовыйСнимок.packet.snapshotId = Строка(Новый УникальныйИдентификатор);
	НовыйСнимок.packet.revision = 1;
	НовыйСнимок.prepared = Новый Соответствие;
	НовыйСнимок.packet.Вставить("lastAppliedRequestId", ИдентификаторЗапроса);
	НовыйСнимок.packet.Вставить("scheduleConfirmedAt", МоментДляКонтракта(ТекущаяДатаСеанса()));
	Состояние.snapshot = НовыйСнимок;
	Состояние.draftChanges = Новый Массив;
	Состояние.optimizing = Ложь;

КонецПроцедуры

Функция ОтветПрименения(Состояние, Квитанция)

	Ответ = ОтветСостояния(Состояние, Квитанция.status, Квитанция.error);
	Ответ.Вставить("requestId", Квитанция.requestId);
	Если Квитанция.status = "applied" Тогда
		Ответ.Вставить("packet", Состояние.snapshot.packet);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция СостояниеСнимка(Адрес, ИдентификаторФормы)

	Состояние = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		ВызватьИсключение "Серверный снимок утрачен. Загрузите данные заново.";
	КонецЕсли;
	Если Состояние.snapshot.packet.formSessionId <> Строка(ИдентификаторФормы) Тогда
		ВызватьИсключение "Серверный снимок принадлежит другой форме.";
	КонецЕсли;
	Возврат Состояние;

КонецФункции

Процедура ПроверитьОболочкуСообщения(Сообщение, Контекст)

	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		ВызватьИсключение "Ожидался объект JSON протокола симулятора.";
	КонецЕсли;
	ОсновныеПоля = "protocolVersion,formSessionId,snapshotId,revision,documentGeneration,event";
	РазрешенныеПоля = ОсновныеПоля;
	Если Сообщение.event = "applySchedules" Тогда
		РазрешенныеПоля = РазрешенныеПоля + ",requestId,modifiedJobs";
	ИначеЕсли Сообщение.event = "draftChanged" Тогда
		РазрешенныеПоля = РазрешенныеПоля + ",modifiedJobs,viewState";
		Если Сообщение.Свойство("optimizing") Тогда
			РазрешенныеПоля = РазрешенныеПоля + ",optimizing";
		КонецЕсли;
	ИначеЕсли Сообщение.event = "optimizationFinished" Тогда
		РазрешенныеПоля = РазрешенныеПоля + ",modifiedJobs,viewState,cancelled";
		Если Сообщение.Свойство("error") Тогда
			РазрешенныеПоля = РазрешенныеПоля + ",error";
		КонецЕсли;
	ИначеЕсли Сообщение.event = "ready" Тогда
		РазрешенныеПоля = РазрешенныеПоля + ",renderedIntervals,viewState";
	ИначеЕсли Сообщение.event = "exportSnapshot" Тогда
		РазрешенныеПоля = РазрешенныеПоля + ",html";
	ИначеЕсли Сообщение.event = "editSchedule" Тогда
		РазрешенныеПоля = РазрешенныеПоля + ",jobId";
	ИначеЕсли Сообщение.event = "preferencesChanged" Тогда
		РазрешенныеПоля = РазрешенныеПоля + ",preferences";
	Иначе
		ВызватьИсключение "Неизвестное событие симулятора.";
	КонецЕсли;
	ПроверитьПоляСтруктуры(Сообщение, РазрешенныеПоля);
	Если Сообщение.protocolVersion <> 1 Или Сообщение.formSessionId <> Контекст.formSessionId Тогда
		ВызватьИсключение "Неверный протокол или владелец сообщения.";
	КонецЕсли;
	Если Сообщение.documentGeneration <> Контекст.documentGeneration Тогда
		ВызватьИсключение "Сообщение пришло из устаревшего поколения HTML.";
	КонецЕсли;
	Если ТипЗнч(Сообщение.revision) <> Тип("Число") Тогда
		ВызватьИсключение "Ревизия сообщения должна быть числом.";
	КонецЕсли;

КонецПроцедуры

Процедура ПринятьЧерновик(Состояние, Сообщение)

	Если Не ПустаяСтрока(Состояние.activeRequest) Тогда
		ВызватьИсключение "Сначала сверьте результат применения расписаний.";
	КонецЕсли;
	ТекущаяРевизия = Состояние.snapshot.packet.revision;
	НачалоОптимизации = Ложь;
	Если Сообщение.Свойство("optimizing") Тогда
		Если ТипЗнч(Сообщение.optimizing) <> Тип("Булево") Тогда
			ВызватьИсключение "Некорректное состояние оптимизации.";
		КонецЕсли;
		НачалоОптимизации = Сообщение.optimizing;
	КонецЕсли;
	ЗавершениеСОшибкой = Сообщение.Свойство("error");
	ОжидаемаяРевизия = ТекущаяРевизия + 1;
	Если НачалоОптимизации Или ЗавершениеСОшибкой Тогда
		ОжидаемаяРевизия = ТекущаяРевизия;
	КонецЕсли;
	Если Сообщение.revision <> ОжидаемаяРевизия Тогда
		ВызватьИсключение "Нарушен порядок ревизий черновика.";
	КонецЕсли;
	Если ТипЗнч(Сообщение.modifiedJobs) <> Тип("Массив") Тогда
		ВызватьИсключение "Правки черновика должны быть массивом.";
	КонецЕсли;
	Если Сообщение.modifiedJobs.Количество() > 0 Тогда
		Запрос = ЗапросПримененияИзСообщения(Сообщение);
		Запрос.revision = ТекущаяРевизия;
		Запрос.requestId = Строка(Новый УникальныйИдентификатор);
		ПодготовитьРасписания(Состояние.snapshot, Запрос);
	КонецЕсли;
	ПринятьСостояниеОтображения(Состояние.snapshot.packet, Сообщение.viewState);
	Состояние.draftChanges = Сообщение.modifiedJobs;
	Состояние.snapshot.packet.revision = Сообщение.revision;
	Состояние.optimizing = НачалоОптимизации;
	УдалитьОтмененныеДобавления(Состояние);

КонецПроцедуры

Процедура УдалитьОтмененныеДобавления(Состояние)

	Индекс = Состояние.snapshot.packet.jobs.Количество();
	Пока Индекс > 0 Цикл
		Индекс = Индекс - 1;
		Карточка = Состояние.snapshot.packet.jobs[Индекс];
		Оригинал = Состояние.snapshot.originals.Получить(Карточка.id);
		Если Не ЭтоНовоеЗадание(Оригинал) Тогда
			Продолжить;
		КонецЕсли;
		ЕстьПравка = Ложь;
		Для Каждого Правка Из Состояние.draftChanges Цикл
			Если Правка.id = Карточка.id Тогда
				ЕстьПравка = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьПравка Тогда
			Состояние.snapshot.packet.jobs.Удалить(Индекс);
			Состояние.snapshot.originals.Удалить(Карточка.id);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПринятьСостояниеОтображения(Пакет, СостояниеОтображения)

	ПроверитьПоляСтруктуры(СостояниеОтображения, "config,pinnedJobIds");
	Настройки = СостояниеОтображения.config;
	Изменяемые = СтрРазделить(
		"simulationDate,maxThreadsThreshold,durationMode,fixedDurationSeconds,resolutionSeconds,offerPause", ",");
	Если ТипЗнч(Настройки) <> Тип("Структура") Или Настройки.Количество() <> Пакет.config.Количество() Тогда
		ВызватьИсключение "Некорректный состав настроек отображения.";
	КонецЕсли;
	Для Каждого Поле Из Пакет.config Цикл
		ЗначениеНастройки = Неопределено;
		Если Не Настройки.Свойство(Поле.Ключ, ЗначениеНастройки) Тогда
			ВызватьИсключение "Отсутствует настройка отображения: " + Поле.Ключ;
		КонецЕсли;
		Если Изменяемые.Найти(Поле.Ключ) = Неопределено И ЗначениеНастройки <> Поле.Значение Тогда
			ВызватьИсключение "Нельзя изменять источник или время серверного снимка через HTML.";
		КонецЕсли;
	КонецЦикла;
	ПроверитьНастройкиОтображения(Настройки);
	Если ТипЗнч(СостояниеОтображения.pinnedJobIds) <> Тип("Массив") Тогда
		ВызватьИсключение "Закрепленные задания должны быть массивом идентификаторов.";
	КонецЕсли;
	Известные = Новый Соответствие;
	Для Каждого Задание Из Пакет.jobs Цикл
		Известные.Вставить(Задание.id, Задание);
	КонецЦикла;
	Закрепленные = Новый Соответствие;
	Для Каждого Идентификатор Из СостояниеОтображения.pinnedJobIds Цикл
		Если Известные.Получить(Идентификатор) = Неопределено Или Закрепленные.Получить(Идентификатор) <> Неопределено Тогда
			ВызватьИсключение "Неизвестное или повторяющееся закрепленное задание.";
		КонецЕсли;
		Закрепленные.Вставить(Идентификатор, Истина);
	КонецЦикла;
	Для Каждого Задание Из Пакет.jobs Цикл
		Задание.pinned = Закрепленные.Получить(Задание.id) <> Неопределено;
	КонецЦикла;
	Пакет.config = Настройки;

КонецПроцедуры

Процедура ПроверитьНастройкиОтображения(Настройки)

	ДатаСимуляции = ДатаИзКонтракта(Настройки.simulationDate);
	Числовые = СтрРазделить("fixedDurationSeconds,maxThreadsThreshold,resolutionSeconds", ",");
	Для Каждого ИмяПоля Из Числовые Цикл
		Если ТипЗнч(Настройки[ИмяПоля]) <> Тип("Число") Тогда
			ВызватьИсключение "Числовые настройки отображения имеют недопустимый тип.";
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Настройки.offerPause) <> Тип("Булево") Тогда
		ВызватьИсключение "Признак предложения паузы должен быть булевым.";
	КонецЕсли;
	Проверяемые = Новый Структура;
	Проверяемые.Вставить("ДатаСимуляции", ДатаСимуляции);
	Проверяемые.Вставить("НачалоПериода", ДатаСимуляции);
	Проверяемые.Вставить("КонецПериода", ДатаСимуляции);
	Проверяемые.Вставить("ИсточникДлительности", "ПамятьКластера");
	Проверяемые.Вставить("РежимДлительности", Настройки.durationMode);
	Проверяемые.Вставить("ФиксированнаяДлительность", Настройки.fixedDurationSeconds);
	Проверяемые.Вставить("ЛимитПотоков", Настройки.maxThreadsThreshold);
	Проверяемые.Вставить("ШагГрафика", Настройки.resolutionSeconds);
	ПроверитьПараметрыСбора(Проверяемые);

КонецПроцедуры

Функция ДатаИзКонтракта(Представление)

	Если ТипЗнч(Представление) <> Тип("Строка") Или СтрДлина(Представление) <> 10 Тогда
		ВызватьИсключение "Дата должна иметь формат ГГГГ-ММ-ДД.";
	КонецЕсли;
	Результат = Дата(СтрЗаменить(Представление, "-", "") + "000000");
	Если Формат(Результат, "ДФ=yyyy-MM-dd") <> Представление Тогда
		ВызватьИсключение "Некорректная дата отображения.";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗапросПримененияИзСообщения(Сообщение)

	Результат = Новый Структура("protocolVersion,formSessionId,snapshotId,revision,requestId,event,modifiedJobs");
	ЗаполнитьЗначенияСвойств(Результат, Сообщение);
	Результат.event = "applySchedules";
	Возврат Результат;

КонецФункции

Функция ОтветСостояния(Состояние, Статус, Текст)

	Ответ = Новый Структура("status,message,revision,dirty,optimizing", Статус, Текст,
		Состояние.snapshot.packet.revision, Состояние.draftChanges.Количество() > 0, Состояние.optimizing);
	Ответ.Вставить("snapshotId", Состояние.snapshot.packet.snapshotId);
	Ответ.Вставить("uncertain", Не ПустаяСтрока(Состояние.activeRequest));
	Возврат Ответ;

КонецФункции

Процедура ПроверитьКонтекстПрименения(Контекст, Запрос)

	ПроверитьПоляСтруктуры(Запрос,
		"protocolVersion,formSessionId,snapshotId,revision,requestId,event,modifiedJobs");
	Если Запрос.protocolVersion <> 1 Или Запрос.event <> "applySchedules" Тогда
		ВызватьИсключение "Неподдерживаемый протокол применения расписаний.";
	КонецЕсли;
	Если Запрос.formSessionId <> Контекст.formSessionId Или Запрос.snapshotId <> Контекст.snapshotId Тогда
		ВызватьИсключение "Документ относится к другому или утраченному снимку. Загрузите данные заново.";
	КонецЕсли;
	Если ТипЗнч(Запрос.revision) <> Тип("Число") Или Запрос.revision <> Контекст.revision Тогда
		ВызватьИсключение "Ревизия черновика устарела. Повторите действие из текущего документа.";
	КонецЕсли;
	Если ТипЗнч(Запрос.requestId) <> Тип("Строка") Или СтрДлина(Запрос.requestId) <> 36 Тогда
		ВызватьИсключение "Не задан идентификатор запроса применения.";
	КонецЕсли;
	ИдентификаторЗапроса = Новый УникальныйИдентификатор(Запрос.requestId);
	Если НРег(Запрос.requestId) <> Строка(ИдентификаторЗапроса) Тогда
		ВызватьИсключение "Недопустимый идентификатор запроса применения.";
	КонецЕсли;
	ПроверитьНепустыеИзменения(Запрос.modifiedJobs);

КонецПроцедуры

Процедура ПроверитьПоляСтруктуры(Данные, РазрешенныеПоля)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "Объект пакета изменений должен быть структурой JSON.";
	КонецЕсли;
	Поля = СтрРазделить(РазрешенныеПоля, ",");
	Если Данные.Количество() <> Поля.Количество() Тогда
		ВызватьИсключение "Неполный пакет изменений или посторонние поля.";
	КонецЕсли;
	Для Каждого Поле Из Поля Цикл
		Если Не Данные.Свойство(Поле) Тогда
			ВызватьИсключение "Недопустимое поле пакета изменений: " + Поле;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНепустыеИзменения(Изменения)

	Если ТипЗнч(Изменения) <> Тип("Массив") Тогда
		ВызватьИсключение "Изменения должны быть массивом JSON.";
	КонецЕсли;
	Если Изменения.Количество() = 0 Тогда
		ВызватьИсключение "Нет изменений для применения.";
	КонецЕсли;

КонецПроцедуры

Процедура ПрименитьПравкиККопии(Копия, Изменения)

	Окна = Копия.ДетальныеРасписанияДня;
	КартаОкон = Новый Соответствие;
	Если Окна.Количество() = 0 Тогда
		КартаОкон.Вставить("root", Копия);
	Иначе
		Для Индекс = 0 По Окна.Количество() - 1 Цикл
			КартаОкон.Вставить("daily:" + Формат(Индекс, "ЧГ=0; ЧН=0"), Окна[Индекс]);
		КонецЦикла;
	КонецЕсли;
	ОбработанныеОкна = Новый Соответствие;
	Для Каждого Изменение Из Изменения Цикл
		ПроверитьПоляСтруктуры(Изменение, "windowId,newStartTime,newRepeatPeriod,newRepeatPause");
		Если ТипЗнч(Изменение.windowId) <> Тип("Строка") Тогда
			ВызватьИсключение "Идентификатор окна должен быть строкой.";
		КонецЕсли;
		Окно = КартаОкон.Получить(Изменение.windowId);
		Если Окно = Неопределено Или ОбработанныеОкна.Получить(Изменение.windowId) <> Неопределено Тогда
			ВызватьИсключение "Неизвестное или повторяющееся окно расписания.";
		КонецЕсли;
		ПроверитьПараметрПовтора(Изменение.newRepeatPeriod);
		ПроверитьПараметрПовтора(Изменение.newRepeatPause);
		Начало = ВремяИзКонтракта(Изменение.newStartTime);
		ПроверитьГраницуНовогоНачала(Окно, Начало);
		Если Изменение.newStartTime <> ВремяДляКонтракта(Окно.ВремяНачала) Тогда
			Окно.ВремяНачала = Начало;
		КонецЕсли;
		Окно.ПериодПовтораВТечениеДня = Изменение.newRepeatPeriod;
		Окно.ПаузаПовтора = Изменение.newRepeatPause;
		ОбработанныеОкна.Вставить(Изменение.windowId, Истина);
	КонецЦикла;
	// Платформа возвращает копию массива; изменения дневных окон нужно присвоить целиком.
	Если Окна.Количество() > 0 Тогда
		Копия.ДетальныеРасписанияДня = Окна;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПараметрПовтора(Значение)

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "Период и пауза должны быть числовыми значениями.";
	КонецЕсли;
	Если Значение < 0 Или Цел(Значение) <> Значение Тогда
		ВызватьИсключение "Период и пауза должны быть неотрицательными целыми секундами.";
	КонецЕсли;

КонецПроцедуры

Функция ВремяИзКонтракта(Представление)

	Если ТипЗнч(Представление) <> Тип("Строка") Тогда
		ВызватьИсключение "Время начала должно быть строкой ЧЧ:ММ:СС.";
	КонецЕсли;
	Если СтрДлина(Представление) <> 8 Или Сред(Представление, 3, 1) <> ":"
		Или Сред(Представление, 6, 1) <> ":" Тогда
		ВызватьИсключение "Время начала должно иметь формат ЧЧ:ММ:СС.";
	КонецЕсли;
	Цифры = Лев(Представление, 2) + Сред(Представление, 4, 2) + Прав(Представление, 2);
	Для Позиция = 1 По 6 Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
			ВызватьИсключение "Время начала содержит недопустимые символы.";
		КонецЕсли;
	КонецЦикла;
	ЧасыНачала = Число(Лев(Цифры, 2));
	МинутыНачала = Число(Сред(Цифры, 3, 2));
	СекундыНачала = Число(Прав(Цифры, 2));
	Если ЧасыНачала > 23 Или МинутыНачала > 59 Или СекундыНачала > 59 Тогда
		ВызватьИсключение "Время начала находится за пределами суток.";
	КонецЕсли;
	// Непустая дата отличает явно заданную полночь от отсутствующего ограничения.
	Возврат Дата(1, 1, 2, ЧасыНачала, МинутыНачала, СекундыНачала);

КонецФункции

Процедура ПроверитьГраницуНовогоНачала(Окно, Начало)

	Если Не ЗначениеЗаполнено(Окно.ВремяКонца) Тогда
		Возврат;
	КонецЕсли;
	ПрежнееНачало = ВремяДляКонтракта(Окно.ВремяНачала);
	Конец = ВремяДляКонтракта(Окно.ВремяКонца);
	НовоеНачало = ВремяДляКонтракта(Начало);
	Если ПрежнееНачало <= Конец И НовоеНачало > Конец Тогда
		ВызватьИсключение "Новое начало выходит за конец дневного окна.";
	КонецЕсли;
	Если ПрежнееНачало > Конец И НовоеНачало <= Конец Тогда
		ВызватьИсключение "Перенос меняет ночное окно на дневное.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьАдминистративныйДоступ()

	// Не считать уже включенный вызывающим кодом привилегированный режим правом пользователя.
	Если Не Пользователи.ЭтоПолноправныйПользователь(Неопределено, Ложь, Ложь) Тогда
		ВызватьИсключение "scheduler4000 доступен только полноправному администратору.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПараметрыСбора(Параметры)

	Если ТипЗнч(Параметры.ДатаСимуляции) <> Тип("Дата")
		Или Не ЗначениеЗаполнено(Параметры.ДатаСимуляции) Тогда
		ВызватьИсключение "Укажите дату симуляции.";
	КонецЕсли;
	Если Параметры.НачалоПериода > Параметры.КонецПериода Тогда
		ВызватьИсключение "Начало периода анализа больше окончания.";
	КонецЕсли;
	Если Параметры.КонецПериода - Параметры.НачалоПериода > 2 * 86400 Тогда
		ВызватьИсключение "Историю можно загрузить максимум за 2 дня. Выберите 1 день или 2 дня.";
	КонецЕсли;
	Если Параметры.ЛимитПотоков <= 0 Или Цел(Параметры.ЛимитПотоков) <> Параметры.ЛимитПотоков Тогда
		ВызватьИсключение "Лимит потоков должен быть положительным целым числом.";
	КонецЕсли;
	Если Параметры.ШагГрафика <> 10 И Параметры.ШагГрафика <> 60 Тогда
		ВызватьИсключение "Шаг графика должен быть равен 10 или 60 секундам.";
	КонецЕсли;
	Если Параметры.РежимДлительности <> "Med" И Параметры.РежимДлительности <> "P95"
		И Параметры.РежимДлительности <> "Fixed" Тогда
		ВызватьИсключение "Неизвестный режим длительности.";
	КонецЕсли;
	Если Параметры.ФиксированнаяДлительность <= 0 Тогда
		ВызватьИсключение "Задайте положительную длительность для прогноза заданий без истории.";
	КонецЕсли;
	Если Параметры.ИсточникДлительности <> "ПамятьКластера"
		И Параметры.ИсточникДлительности <> "ЖурналРегистрации" Тогда
		ВызватьИсключение "Источник не поддержан. Выберите память фоновых заданий или журнал регистрации.";
	КонецЕсли;

КонецПроцедуры

Функция СобратьДанныеСРазрешеннымДоступом(Параметры)

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СообщитьЭтапСбора(Параметры, "Получаем список заданий и расписания...");
	МоментСбора = ТекущаяДатаСеанса();
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	ЗаданияИБ = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	КартаПодсистем = Новый Соответствие;
	СобратьПринадлежностьПодсистемам(Метаданные.Подсистемы, "", КартаПодсистем);
	Карточки = Новый Массив;
	Оригиналы = Новый Соответствие;
	КартаЗаданий = Новый Соответствие;
	КартаМетодов = Новый Соответствие;
	КартаМетаданных = Новый Соответствие;
	Для Каждого ЗаданиеИБ Из ЗаданияИБ Цикл
		Карточка = КарточкаЗадания(ЗаданиеИБ, КартаПодсистем);
		Карточки.Добавить(Карточка);
		КартаЗаданий.Вставить(Карточка.id, Карточка);
		ДобавитьВГруппу(КартаМетодов, Карточка.methodName, Карточка.id);
		КартаМетаданных.Вставить(ЗаданиеИБ.Метаданные.ПолноеИмя(), Карточка.methodName);
		Оригиналы.Вставить(Карточка.id, ОригиналЗадания(ЗаданиеИБ));
	КонецЦикла;
	Если Параметры.ИсточникДлительности = "ПамятьКластера" Тогда
		История = ПрочитатьПамятьФоновыхЗаданий(КартаЗаданий, КартаМетодов, Параметры);
	Иначе
		История = ПрочитатьЖурналЗаданий(КартаМетаданных, КартаМетодов, Параметры);
	КонецЕсли;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	СообщитьЭтапСбора(Параметры, "Рассчитываем длительности и готовим фактические интервалы...");
	Самостоятельные = РаспределитьИсторию(История.intervals, КартаЗаданий, Параметры, МоментСбора);
	// В карточках остались только образцы и исходное состояние; полная история больше не нужна.
	История.intervals.Очистить();
	История.intervals = Неопределено;
	Пакет = Новый Структура;
	Пакет.Вставить("protocolVersion", 1);
	Пакет.Вставить("formSessionId", Строка(Параметры.ИдентификаторФормы));
	Пакет.Вставить("snapshotId", Строка(Новый УникальныйИдентификатор));
	Пакет.Вставить("revision", 1);
	Пакет.Вставить("config", НастройкиДляКонтракта(Параметры, МоментСбора));
	Пакет.Вставить("jobs", Карточки);
	Пакет.Вставить("unmappedIntervals", Самостоятельные);
	Пакет.Вставить("sourceQuality", История.quality);
	Пакет.Вставить("bspHistorySource", ДоступностьРегистраИстории());
	Пакет.Вставить("collectionMilliseconds", ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала);
	Возврат Новый Структура("packet,originals", Пакет, Оригиналы);

