&НаКлиенте
Перем РазрешеноЗакрытие;
&НаКлиенте
Перем ЗаданиеДляПодробногоРасписания;
&НаКлиенте
Перем ЗагрузкаВыполняется, ОтменаЗагрузкиЗапрошена, ИдентификаторФоновойЗагрузки,
	АдресФайлаДляФона, НомерЗагрузки, СостояниеПередЗагрузкой, АдресРезультатаФоновойЗагрузки;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Пользователи.ЭтоПолноправныйПользователь(Неопределено, Ложь, Ложь) Тогда
		Отказ = Истина;
		ВызватьИсключение "scheduler4000 доступен только полноправному администратору.";
	КонецЕсли;
	Сейчас = ТекущаяДатаСеанса();
	ЭтотОбъект.ДатаСимуляции = НачалоДня(Сейчас) + 86400;
	ЭтотОбъект.ИсточникДлительности = "ПамятьКластера";
	ЭтотОбъект.ПериодАнализаЖР = НачальныйПериод(Сейчас);
	ЭтотОбъект.ПериодПоУмолчанию = Истина;
	ЭтотОбъект.РежимДлительности = "Med";
	ЭтотОбъект.ДлительностьФиксированная = 30;
	ЭтотОбъект.ЛимитПотоков = 8;
	ЭтотОбъект.ШагГрафика = 60;
	ЭтотОбъект.ДнейИстории = 2;
	ЗагрузитьПользовательскиеНастройки();
	Если ДнейИстории <> 1 И ДнейИстории <> 2 Тогда
		ЭтотОбъект.ДнейИстории = 2;
	КонецЕсли;
	ЭтотОбъект.ПериодАнализаЖР = НачальныйПериод(Сейчас);
	ЭтотОбъект.Состояние = "Нажмите «1. Загрузить задания».";
	ЭтотОбъект.ПоколениеHTML = Строка(Новый УникальныйИдентификатор);
	ЭтотОбъект.ПолеHTML = HTMLНаСервере(ПоколениеHTML);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ЗагрузкаВыполняется = Ложь;
	ОтключитьОбработчикОжидания("ПроверитьФоновуюЗагрузку");
	Если Не ЗавершениеРаботы И ИдентификаторФоновойЗагрузки <> Неопределено Тогда
		Попытка
			ОтменитьЗагрузкуНаСервере(ИдентификаторФоновойЗагрузки);
		Исключение
			// При разрыве соединения фоновое чтение не записывает расписания или прикладные данные.
			Возврат;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	РазрешеноЗакрытие = Ложь;
	ЗагрузкаВыполняется = Ложь;
	НомерЗагрузки = 0;
	ОбновитьДоступность();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если РазрешеноЗакрытие Тогда
		Возврат;
	КонецЕсли;
	Если ЧерновикИзменен Или ПрименениеНеопределено Тогда
		Отказ = Истина;
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = "Черновик расписаний не записан. Завершить работу без сохранения?";
			Если ПрименениеНеопределено Тогда
				ТекстПредупреждения = "Результат применения не подтвержден. Перед выходом сверьте его командой применения.";
			КонецЕсли;
			Возврат;
		КонецЕсли;
		ПодтвердитьЗакрытиеАсинх();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеHTMLДокументСформирован(Элемент)

	Если ДанныеЗагружены И Не ПустаяСтрока(ПакетJSON) Тогда
		Попытка
			Ответ = Элементы.ПолеHTMLДокумента.Документ.defaultView.initSimulator(ПакетJSON);
			Если Ответ <> "JS_OK" Тогда
				ВызватьИсключение "Браузер не подтвердил инициализацию симулятора.";
			КонецЕсли;
		Исключение
			ПоказатьОшибку("Не удалось построить графики: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	НажатыйЭлемент = ДанныеСобытия.Element;
	Если НажатыйЭлемент.id <> "v8bridge" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Если ЗагрузкаВыполняется Тогда
		Возврат;
	КонецЕсли;
	ТекстСообщения = НажатыйЭлемент.getAttribute("data-payload");
	Сообщение = Неопределено;
	ВидСобытия = "";
	Попытка
		Если СтрДлина(ТекстСообщения) > 16777216 Тогда
			ВызватьИсключение "Превышен допустимый размер сообщения HTML.";
		КонецЕсли;
		Сообщение = ПрочитатьПакет(ТекстСообщения);
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			ВызватьИсключение "Сообщение моста должно быть объектом JSON.";
		КонецЕсли;
		Сообщение.Свойство("event", ВидСобытия);
		Если Сообщение.documentGeneration <> ПоколениеHTML Тогда
			Возврат;
		КонецЕсли;
		ОтветJSON = ОбработатьПакетНаСервере(ТекстСообщения);
		ОтветСервера = ПрочитатьПакет(ОтветJSON);
		Если Сообщение.event = "applySchedules" Тогда
			Элементы.ПолеHTMLДокумента.Документ.defaultView.simulatorServerReply(ОтветJSON);
		ИначеЕсли ОтветСервера.status = "export" Тогда
			// Синхронное событие не ожидает диалог; делегат сам обрабатывает ошибки.
			СохранитьПолученныйHTMLАсинх(Сообщение.html);
		ИначеЕсли ОтветСервера.status = "editSchedule" Тогда
			ОткрытьПодробноеРасписание(ОтветСервера.jobId);
		КонецЕсли;
		ОбновитьДоступность();
	Исключение
		Если ВидСобытия = "applySchedules" Тогда
			ЭтотОбъект.ПрименениеНеопределено = Истина;
			ОтветНеопределенности = Новый Структура("status,message", "uncertain",
				"Результат применения требует сверки. Повторите команду применения для проверки.");
			Элементы.ПолеHTMLДокумента.Документ.defaultView.simulatorServerReply(ЗаписатьПакет(ОтветНеопределенности));
		КонецЕсли;
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура НастройкиСимуляцииПриИзменении(Элемент)

	ОбновитьДоступность();
	ТекстПроверки = ТекстОшибкиПараметров();
	Если Не ПустаяСтрока(ТекстПроверки) Тогда
		ПоказатьОшибку(ТекстПроверки);
		Возврат;
	КонецЕсли;
	СохранитьПользовательскиеНастройки();
	Если Не ДанныеЗагружены Тогда
		Возврат;
	КонецЕсли;
	Настройки = Новый Структура;
	Настройки.Вставить("simulationDate", Формат(ДатаСимуляции, "ДФ=yyyy-MM-dd"));
	Настройки.Вставить("durationMode", РежимДлительности);
	Настройки.Вставить("fixedDurationSeconds", ДлительностьФиксированная);
	Настройки.Вставить("maxThreadsThreshold", ЛимитПотоков);
	Настройки.Вставить("resolutionSeconds", ШагГрафика);
	Настройки.Вставить("offerPause", ПредлагатьЗаменуПериодаПаузой);
	Попытка
		Элементы.ПолеHTMLДокумента.Документ.defaultView.updateSimulatorSettings(ЗаписатьПакет(Настройки));
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаЗаданий
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ЗагрузитьИПостроить(Команда)

	Если ЗагрузкаВыполняется Тогда
		Возврат;
	КонецЕсли;
	ТекстПроверки = ТекстОшибкиПараметров();
	Если Не ПустаяСтрока(ТекстПроверки) Тогда
		ПоказатьОшибку(ТекстПроверки);
		Возврат;
	КонецЕсли;
	Если ЧерновикИзменен Или ПрименениеНеопределено Тогда
		Решение = Ждать ВопросАсинх(
			"Сохранить текущий черновик в HTML перед загрузкой? Да - сохранить, Нет - отбросить, Отмена - остаться.",
			РежимДиалогаВопрос.ДаНетОтмена);
		Если Решение = КодВозвратаДиалога.Отмена Тогда
			Возврат;
		КонецЕсли;
		Если Решение = КодВозвратаДиалога.Да Тогда
			ТекстHTML = Элементы.ПолеHTMLДокумента.Документ.defaultView.exportSimulatorHTML();
			Сохранено = Ждать СохранитьHTMLАсинх(ТекстHTML);
			Если Не Сохранено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ПодготовитьФоновуюЗагрузку();

КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьФоновуюЗагрузку()

	СостояниеПередЗагрузкой = Состояние;
	ЗагрузкаВыполняется = Истина;
	ОтменаЗагрузкиЗапрошена = Ложь;
	ИдентификаторФоновойЗагрузки = Неопределено;
	НомерЗагрузки = НомерЗагрузки + 1;
	ОбновитьДоступность();
	Попытка
		ПоказатьХодЗагрузки("Подготавливаем фоновую загрузку истории...");
		Если ПустаяСтрока(АдресФайлаДляФона) Тогда
			ФайлДляФона = ПодготовитьФайлФонаНаСервере();
			АдресФайлаДляФона = ФайлДляФона.Адрес;
			Если ПустаяСтрока(АдресФайлаДляФона) Тогда
				ПараметрыФайла = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
				ПараметрыФайла.ИдентификаторФормы = УникальныйИдентификатор;
				ПараметрыФайла.Интерактивно = Ложь;
				Оповещение = Новый ОписаниеОповещения("ПослеПередачиФайлаДляФона", ЭтотОбъект, НомерЗагрузки);
				ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыФайла, ФайлДляФона.ИмяФайла);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		НачатьОжиданиеЗагрузки();
	Исключение
		ЗавершитьОжиданиеЗагрузки("Не удалось начать загрузку: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Продолжает запуск после передачи клиентского файла на сервер кластера.
// Параметры:
//  Файл - Структура, Неопределено - результат ЗагрузитьФайл БСП.
//  НомерПопытки - Число - номер запуска для отсечения отмененной передачи.
&НаКлиенте
Процедура ПослеПередачиФайлаДляФона(Файл, НомерПопытки) Экспорт

	Если Не Открыта() Или Не ЗагрузкаВыполняется Или НомерПопытки <> НомерЗагрузки Тогда
		Возврат;
	КонецЕсли;
	Если Файл = Неопределено Тогда
		ЗавершитьОжиданиеЗагрузки("Не удалось передать открытый файл обработки на сервер.");
		Возврат;
	КонецЕсли;
	АдресФайлаДляФона = Файл.Хранение;
	Попытка
		НачатьОжиданиеЗагрузки();
	Исключение
		ЗавершитьОжиданиеЗагрузки("Не удалось начать загрузку: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура НачатьОжиданиеЗагрузки()

	Операция = НачатьЗагрузкуНаСервере(АдресФайлаДляФона);
	ИдентификаторФоновойЗагрузки = Операция.ИдентификаторЗадания;
	АдресРезультатаФоновойЗагрузки = Операция.АдресРезультата;
	Если Операция.Статус <> "Выполняется" Тогда
		ПослеФоновойЗагрузки(Операция, НомерЗагрузки);
	Иначе
		ПодключитьОбработчикОжидания("ПроверитьФоновуюЗагрузку", 1);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновуюЗагрузку()

	Если Не ЗагрузкаВыполняется Тогда
		ОтключитьОбработчикОжидания("ПроверитьФоновуюЗагрузку");
		Возврат;
	КонецЕсли;
	Попытка
		Операция = СостояниеЗагрузкиНаСервере(ИдентификаторФоновойЗагрузки, АдресРезультатаФоновойЗагрузки);
		Если Операция.Статус = "Выполняется" Тогда
			ПриПрогрессеЗагрузки(Операция, НомерЗагрузки);
		Иначе
			ПослеФоновойЗагрузки(Операция, НомерЗагрузки);
		КонецЕсли;
	Исключение
		// При потере связи остановка ожидания не подменяет готовым результатом старый снимок.
		ЭтотОбъект.Состояние = "Не удалось проверить загрузку. Повторяем проверку; можно отменить: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Обновляет этап чтения; готовые данные принимаются отдельным оповещением.
// Параметры:
//  Операция - Структура - статус и прогресс операции БСП.
//  НомерПопытки - Число - номер ожидаемого запуска.
&НаКлиенте
Процедура ПриПрогрессеЗагрузки(Операция, НомерПопытки) Экспорт

	Если Не ЗагрузкаВыполняется Или НомерПопытки <> НомерЗагрузки Или ОтменаЗагрузкиЗапрошена Тогда
		Возврат;
	КонецЕсли;
	Если Операция.Прогресс <> Неопределено И Операция.Прогресс.Свойство("Текст") Тогда
		ПоказатьХодЗагрузки(Операция.Прогресс.Текст);
	КонецЕсли;

КонецПроцедуры

// Публикует целый готовый снимок, сохраняя прежний при ошибке или отмене.
// Параметры:
//  Операция - Структура, Неопределено - результат ожидания БСП.
//  НомерПопытки - Число - номер ожидаемого запуска.
&НаКлиенте
Процедура ПослеФоновойЗагрузки(Операция, НомерПопытки) Экспорт

	Если Не Открыта() Или Не ЗагрузкаВыполняется Или НомерПопытки <> НомерЗагрузки Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ОтменаЗагрузкиЗапрошена Или Операция = Неопределено Тогда
			Если Операция <> Неопределено Тогда
				ОсвободитьРезультатЗагрузкиНаСервере(Операция.АдресРезультата);
			КонецЕсли;
			ЗавершитьОжиданиеЗагрузки();
		ИначеЕсли Операция.Статус = "Выполнено" Тогда
			ПоказатьХодЗагрузки("Данные прочитаны. Подготавливаем графики...");
			ПринятьРезультатЗагрузкиНаСервере(Операция.АдресРезультата);
			ЗавершитьОжиданиеЗагрузки(, Истина);
		ИначеЕсли Операция.Статус = "Отменено" Тогда
			ЗавершитьОжиданиеЗагрузки();
		Иначе
			ЗавершитьОжиданиеЗагрузки("Не удалось прочитать журнал: " + Операция.КраткоеПредставлениеОшибки);
		КонецЕсли;
	Исключение
		ЗавершитьОжиданиеЗагрузки("Не удалось обновить снимок: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьХодЗагрузки(ТекстЭтапа)

	ЭтотОбъект.Состояние = ТекстЭтапа;
	Попытка
		Элементы.ПолеHTMLДокумента.Документ.defaultView.showCollectionProgress(ТекстЭтапа);
	Исключение
		// При смене документа этап остается доступен в строке состояния формы.
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОжиданиеЗагрузки(ТекстОшибки = "", Успешно = Ложь)

	ЗагрузкаВыполняется = Ложь;
	ОтключитьОбработчикОжидания("ПроверитьФоновуюЗагрузку");
	ИдентификаторФоновойЗагрузки = Неопределено;
	ЭтотОбъект.Состояние = СостояниеПередЗагрузкой;
	Если Успешно Тогда
		ЭтотОбъект.Состояние = "Данные получены. Ожидание построения графиков.";
	КонецЕсли;
	ОбновитьДоступность();
	Если Не Успешно Тогда
		Попытка
			Элементы.ПолеHTMLДокумента.Документ.defaultView.showCollectionProgress("");
		Исключение
			ЭтотОбъект.Состояние = "Загрузка завершена. HTML-поле недоступно; переоткройте обработку.";
		КонецПопытки;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьОшибку(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОптимизироватьПики(Команда)

	ВыполнитьКомандуHTML("optimize");

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьРасписанияВБазу(Команда)

	ВыполнитьКомандуHTML("apply");

КонецПроцедуры

&НаКлиенте
Процедура ОткатитьИзменения(Команда)

	ВыполнитьКомандуHTML("rollback");

КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтчетHTML(Команда)

	ВыполнитьКомандуHTML("export");

КонецПроцедуры

&НаКлиенте
Процедура НастроитьВыбранноеЗадание(Команда)

	Если Не ЗначениеЗаполнено(ИдентификаторЗаданияДляНастройки) Тогда
		ПоказатьОшибку("Выберите задание для настройки.");
		Возврат;
	КонецЕсли;
	Элементы.ПолеHTMLДокумента.Документ.defaultView.openSimulatorJobEditor(ИдентификаторЗаданияДляНастройки);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗадание(Команда)

	Попытка
		Данные = ДанныеДобавленияНаСервере();
		Оповещение = Новый ОписаниеОповещения("ДобавлениеЗаданияЗавершение", ЭтотОбъект, Данные.Контекст);
		ПрефиксФормы = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".Форма.") - 1);
		ОткрытьФорму(ПрефиксФормы + ".Форма.НастройкаЗадания", Новый Структура("Данные", Данные),
			ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОптимизацию(Команда)

	Если ЗагрузкаВыполняется Тогда
		ОтменаЗагрузкиЗапрошена = Истина;
		Если ИдентификаторФоновойЗагрузки = Неопределено Тогда
			ЗавершитьОжиданиеЗагрузки();
		Иначе
			Попытка
				ОтменитьЗагрузкуНаСервере(ИдентификаторФоновойЗагрузки);
				ПоказатьХодЗагрузки("Отменяем загрузку истории. Прежний график сохранится...");
			Исключение
				ПоказатьХодЗагрузки("Запрос отмены не доставлен. Ожидаем связь; новый результат не будет принят.");
			КонецПопытки;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ВыполнитьКомандуHTML("cancel");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки(Команда)

	Настройки = Новый Структура;
	Для Каждого Имя Из ИменаПараметровПрогноза() Цикл
		Настройки.Вставить(Имя, ЭтотОбъект[Имя]);
	КонецЦикла;
	ПрефиксФормы = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".Форма.") - 1);
	Оповещение = Новый ОписаниеОповещения("НастройкиПрогнозаЗавершение", ЭтотОбъект);
	ОткрытьФорму(ПрефиксФормы + ".Форма.НастройкиПрогноза", Новый Структура("Настройки", Настройки),
		ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкцию(Команда)

	ПрефиксФормы = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".Форма.") - 1);
	ОткрытьФорму(ПрефиксФормы + ".Форма.Справка", , ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция НачальныйПериод(Сейчас)

	ПериодНастроек = Новый СтандартныйПериод;
	ПериодНастроек.ДатаНачала = Сейчас - 2 * 86400;
	ПериодНастроек.ДатаОкончания = Сейчас;
	Возврат ПериодНастроек;

КонецФункции

&НаСервере
Функция HTMLНаСервере(ИдентификаторПоколения)

	Обработка = РеквизитФормыВЗначение("Объект");
	Макет = Обработка.ПолучитьМакет("МакетHTML");
	Библиотеки = Обработка.ПолучитьМакет("МакетJS");
	ТекстHTML = СтрЗаменить(Макет.ПолучитьТекст(), "@@VENDOR@@", Библиотеки.ПолучитьТекст());
	Возврат СтрЗаменить(ТекстHTML, "@@GENERATION@@", ИдентификаторПоколения);

КонецФункции

&НаСервере
Функция ПараметрыСбораНаСервере()

	Если ДнейИстории <> 1 И ДнейИстории <> 2 Тогда
		ВызватьИсключение "Выберите глубину истории: 1 день или 2 дня.";
	КонецЕсли;
	КонецПериода = ТекущаяДатаСеанса();
	ПараметрыСбора = Новый Структура;
	ПараметрыСбора.Вставить("ИдентификаторФормы", УникальныйИдентификатор);
	ПараметрыСбора.Вставить("ДатаСимуляции", ДатаСимуляции);
	ПараметрыСбора.Вставить("НачалоПериода", КонецПериода - ДнейИстории * 86400);
	ПараметрыСбора.Вставить("КонецПериода", КонецПериода);
	ПараметрыСбора.Вставить("ИсточникДлительности", ИсточникДлительности);
	ПараметрыСбора.Вставить("РежимДлительности", РежимДлительности);
	ПараметрыСбора.Вставить("ФиксированнаяДлительность", ДлительностьФиксированная);
	ПараметрыСбора.Вставить("ЛимитПотоков", ЛимитПотоков);
	ПараметрыСбора.Вставить("ШагГрафика", ШагГрафика);
	Возврат ПараметрыСбора;

КонецФункции

&НаСервере
Функция ПодготовитьФайлФонаНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ИмяФайла = Обработка.ИспользуемоеИмяФайла;
	Адрес = "";
	Попытка
		ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
		Адрес = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
	Исключение
		// Исходный файл может находиться только на компьютере тонкого клиента.
		Возврат Новый Структура("Адрес,ИмяФайла", Адрес, ИмяФайла);
	КонецПопытки;
	Возврат Новый Структура("Адрес,ИмяФайла", Адрес, ИмяФайла);

КонецФункции

&НаСервере
Функция НачатьЗагрузкуНаСервере(Знач АдресФайла)

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.НачатьСборДанныхВФоне(ПараметрыСбораНаСервере(), АдресФайла);

КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьЗагрузкуНаСервере(Знач Идентификатор)

	ДлительныеОперации.ОтменитьВыполнениеЗадания(Идентификатор);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СостояниеЗагрузкиНаСервере(Знач Идентификатор, Знач АдресРезультата)

	Результат = ДлительныеОперации.ЗаданиеВыполнено(Идентификатор, Истина);
	// Объект ФоновоеЗадание остается на сервере; клиент получает только состояние и адрес.
	Результат.Удалить("Задание");
	Результат.Вставить("АдресРезультата", АдресРезультата);
	Результат.Вставить("Прогресс", Неопределено);
	Если Результат.Статус = "Выполняется" Тогда
		Результат.Прогресс = ДлительныеОперации.ПрочитатьПрогресс(Идентификатор);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПринятьРезультатЗагрузкиНаСервере(Знач АдресРезультата)

	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Результат.Параметры.ИдентификаторФормы <> УникальныйИдентификатор Тогда
		ВызватьИсключение "Готовый результат загрузки недоступен или принадлежит другой форме.";
	КонецЕсли;
	ПринятьГотовыйСнимок(Результат.Снимок, Результат.Параметры);
	УдалитьИзВременногоХранилища(АдресРезультата);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОсвободитьРезультатЗагрузкиНаСервере(Знач АдресРезультата)

	Если Не ПустаяСтрока(АдресРезультата) Тогда
		УдалитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПринятьГотовыйСнимок(Снимок, ПараметрыСбора)

	Обработка = РеквизитФормыВЗначение("Объект");
	НовоеПоколение = Строка(Новый УникальныйИдентификатор);
	Снимок.packet.Вставить("documentGeneration", НовоеПоколение);
	Снимок.packet.config.Вставить("offerPause", ПредлагатьЗаменуПериодаПаузой);
	Снимок.packet.config.Вставить("nativeJobEditor", Истина);
	Если Не ПустаяСтрока(НастройкиПредставленияJSON) Тогда
		Снимок.packet.Вставить("preferences", Обработка.ПроверитьНастройкиПредставления(НастройкиПредставленияJSON));
	КонецЕсли;
	НовыйHTML = HTMLНаСервере(НовоеПоколение);
	НовыйПакетJSON = Обработка.ПакетВJSON(Снимок.packet);
	НовыйАдрес = Обработка.СоздатьСерверныйСнимок(Снимок, УникальныйИдентификатор, АдресСнимка);
	// Атрибуты меняются после успешной подготовки целого снимка.
	ЭтотОбъект.АдресСнимка = НовыйАдрес;
	ЭтотОбъект.ПакетJSON = НовыйПакетJSON;
	ЭтотОбъект.ПоколениеHTML = НовоеПоколение;
	ЭтотОбъект.ПолеHTML = НовыйHTML;
	ЭтотОбъект.ИдентификаторСнимка = Снимок.packet.snapshotId;
	ЭтотОбъект.РевизияСнимка = Снимок.packet.revision;
	ПериодЧтения = Новый СтандартныйПериод;
	ПериодЧтения.ДатаНачала = ПараметрыСбора.НачалоПериода;
	ПериодЧтения.ДатаОкончания = ПараметрыСбора.КонецПериода;
	ЭтотОбъект.ПериодАнализаЖР = ПериодЧтения;
	ЭтотОбъект.ДанныеЗагружены = Истина;
	ЭтотОбъект.ИсторияТребуетОбновления = Ложь;
	ЭтотОбъект.ЧерновикИзменен = Ложь;
	ЭтотОбъект.ОптимизацияВыполняется = Ложь;
	ЭтотОбъект.ПрименениеНеопределено = Ложь;
	ЗаполнитьТаблицуЗаданий(Снимок.packet.jobs);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЗаданий(Задания)

	ТаблицаЗаданий.Очистить();
	Элементы.ЗаданиеДляНастройкиПоле.СписокВыбора.Очистить();
	Для Каждого Задание Из Задания Цикл
		ПредставлениеВыбора = Задание.name + ?(Задание.enabled, "", " (отключено)");
		Элементы.ЗаданиеДляНастройкиПоле.СписокВыбора.Добавить(Задание.id, ПредставлениеВыбора);
		СтрокаЗадания = ТаблицаЗаданий.Добавить();
		СтрокаЗадания.Идентификатор = Задание.id;
		СтрокаЗадания.Наименование = Задание.name;
		СтрокаЗадания.Метод = Задание.methodName;
		СтрокаЗадания.Подсистема = Задание.subsystem;
		СтрокаЗадания.РазмерВыборки = Задание.sampleCount;
		СтрокаЗадания.Закреплено = Задание.pinned;
		Если Задание.durationMed <> Неопределено Тогда
			СтрокаЗадания.Медиана = Задание.durationMed;
			СтрокаЗадания.P95 = Задание.durationP95;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОбработатьПакетНаСервере(Знач ТекстСообщения)

	Обработка = РеквизитФормыВЗначение("Объект");
	Ответ = Обработка.ОбработатьСообщениеСимулятора(АдресСнимка, УникальныйИдентификатор, ТекстСообщения);
	Если Ответ.status = "preferences" Тогда
		ЭтотОбъект.НастройкиПредставленияJSON = Обработка.ПакетВJSON(Ответ.preferences);
		СохранитьПользовательскиеНастройки();
	КонецЕсли;
	ЭтотОбъект.ЧерновикИзменен = Ответ.dirty;
	ЭтотОбъект.ОптимизацияВыполняется = Ответ.optimizing;
	ЭтотОбъект.ПрименениеНеопределено = Ответ.uncertain;
	ЭтотОбъект.ИдентификаторСнимка = Ответ.snapshotId;
	ЭтотОбъект.РевизияСнимка = Ответ.revision;
	Если Ответ.status = "applied" Тогда
		ЭтотОбъект.ПакетJSON = Обработка.ПакетВJSON(Ответ.packet);
		ЗаполнитьТаблицуЗаданий(Ответ.packet.jobs);
	ИначеЕсли Ответ.Свойство("jobs") Тогда
		ЗаполнитьТаблицуЗаданий(Ответ.jobs);
	КонецЕсли;
	ЭтотОбъект.Состояние = "Готово";
	Если ЧерновикИзменен Тогда
		ЭтотОбъект.Состояние = "Есть изменения. Нажмите «3. Сохранить расписания».";
	КонецЕсли;
	Если ОптимизацияВыполняется Тогда
		ЭтотОбъект.Состояние = "Распределяем запуски...";
	КонецЕсли;
	Если Не ПустаяСтрока(Ответ.message) Тогда
		ЭтотОбъект.Состояние = Ответ.message;
	КонецЕсли;
	Если ИсторияТребуетОбновления И Не ОптимизацияВыполняется И Не ПрименениеНеопределено
		И ПустаяСтрока(Ответ.message) Тогда
		ЭтотОбъект.Состояние = "Источник или период изменены. Нажмите «1. Загрузить задания» для обновления истории.";
	КонецЕсли;
	Возврат Обработка.ПакетВJSON(Ответ);

КонецФункции

&НаКлиенте
Процедура ОткрытьПодробноеРасписание(ИдентификаторЗадания)

	// Нативный диалог открывается после возврата из события встроенного браузера.
	ЗаданиеДляПодробногоРасписания = ИдентификаторЗадания;
	ПодключитьОбработчикОжидания("ПоказатьПодробноеРасписание", 0.1, Истина);

КонецПроцедуры

&НаСервере
Функция ДанныеДобавленияНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Варианты = Обработка.ВариантыДобавленияЗадания(АдресСнимка, УникальныйИдентификатор);
	Если Варианты.types.Количество() = 0 Тогда
		ВызватьИсключение "В конфигурации нет типов заданий, для которых разрешено создание экземпляров.";
	КонецЕсли;
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ВремяНачала = Дата(1, 1, 1, 8, 0, 0);
	Возврат Новый Структура("Наименование,Включено,Расписание,ВариантыДобавления,Контекст",
		"Новое задание", Ложь, Расписание, Варианты.types, Варианты.context);

КонецФункции

// Добавляет подтвержденную карточку в снимок и прогноз без записи в базу.
// Параметры:
//  Результат - Структура, Неопределено - расписание, активность и описание либо отмена.
//  ДополнительныеПараметры - Структура - ревизия и идентификатор снимка при открытии карточки.
&НаКлиенте
Процедура ДобавлениеЗаданияЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		КарточкаJSON = ПодготовитьДобавлениеНаСервере(Результат, ДополнительныеПараметры);
		Элементы.ПолеHTMLДокумента.Документ.defaultView.acceptNewSimulatorJob(КарточкаJSON);
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПодготовитьДобавлениеНаСервере(Знач Результат, Знач Контекст)

	Обработка = РеквизитФормыВЗначение("Объект");
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Результат.ОписаниеНовогоЗаданияJSON);
	Описание = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Добавление = Обработка.ПодготовитьНовоеЗадание(АдресСнимка, УникальныйИдентификатор,
		Описание, Результат.Расписание, Результат.Включено, Контекст);
	ЗаполнитьТаблицуЗаданий(Добавление.jobs);
	Возврат Обработка.ПакетВJSON(Добавление.job);

КонецФункции

&НаКлиенте
Процедура ПоказатьПодробноеРасписание() Экспорт

	Попытка
		ДанныеРедактора = РасписаниеДляРедактораНаСервере(ЗаданиеДляПодробногоРасписания);
		ПараметрыПродолжения = Новый Структура("ИдентификаторЗадания,Контекст",
			ЗаданиеДляПодробногоРасписания, ДанныеРедактора.Контекст);
		Оповещение = Новый ОписаниеОповещения("ПодробноеРасписаниеЗавершение", ЭтотОбъект, ПараметрыПродолжения);
		ПрефиксФормы = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".Форма.") - 1);
		ОткрытьФорму(ПрефиксФормы + ".Форма.НастройкаЗадания",
			Новый Структура("Данные", ДанныеРедактора), ЭтотОбъект,
			,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Принимает результат отдельной HTML-формы в черновик без записи в ИБ.
// Параметры:
//  Результат - Структура, Неопределено - Расписание и Включено либо отмена.
//  КонтекстПродолжения - Структура - идентификатор задания и контекст серверного снимка.
&НаКлиенте
Процедура ПодробноеРасписаниеЗавершение(Результат, КонтекстПродолжения) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОтветJSON = ПринятьПодробноеРасписаниеНаСервере(КонтекстПродолжения.ИдентификаторЗадания,
			Результат.Расписание, КонтекстПродолжения.Контекст, Результат.Включено);
		Элементы.ПолеHTMLДокумента.Документ.defaultView.acceptDetailedSchedule(ОтветJSON);
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция РасписаниеДляРедактораНаСервере(Знач ИдентификаторЗадания)

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьРасписаниеДляРедактора(АдресСнимка, УникальныйИдентификатор,
		ИдентификаторЗадания);

КонецФункции

&НаСервере
Функция ПринятьПодробноеРасписаниеНаСервере(Знач ИдентификаторЗадания, Знач Расписание,
	Знач Контекст, Знач Включено)

	Если ТипЗнч(Включено) <> Тип("Булево") Тогда
		ВызватьИсключение "Признак включения задания должен быть булевым.";
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ПодготовитьПодробноеРасписание(АдресСнимка, УникальныйИдентификатор,
		ИдентификаторЗадания, Расписание, Контекст);
	Результат.Вставить("enabled", Включено);
	Возврат Обработка.ПакетВJSON(Результат);

КонецФункции

&НаСервере
Процедура ЗагрузитьПользовательскиеНастройки()

	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("scheduler4000", "ПараметрыВерсия1");
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Имя Из ИменаСохраняемыхНастроек() Цикл
		ЗначениеНастройки = Неопределено;
		Если Настройки.Свойство(Имя, ЗначениеНастройки) И ТипЗнч(ЗначениеНастройки) = ТипЗнч(ЭтотОбъект[Имя]) Тогда
			ЭтотОбъект[Имя] = ЗначениеНастройки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьПользовательскиеНастройки()

	Настройки = Новый Структура;
	Для Каждого Имя Из ИменаСохраняемыхНастроек() Цикл
		Настройки.Вставить(Имя, ЭтотОбъект[Имя]);
	КонецЦикла;
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("scheduler4000", "ПараметрыВерсия1", Настройки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИменаСохраняемыхНастроек()

	Возврат СтрРазделить("ДатаСимуляции,ИсточникДлительности,ДнейИстории,ПериодАнализаЖР,ПериодПоУмолчанию,"
		+ "РежимДлительности,ДлительностьФиксированная,ЛимитПотоков,ШагГрафика,"
		+ "ПредлагатьЗаменуПериодаПаузой,НастройкиПредставленияJSON", ",");

КонецФункции

&НаКлиенте
Процедура ОбновитьДоступность()

	Свободно = Не ОптимизацияВыполняется И Не ЗагрузкаВыполняется;
	Элементы.ГлавныеПараметры.Доступность = Свободно И Не ПрименениеНеопределено;
	Элементы.КнопкаНастройки.Доступность = Свободно И Не ПрименениеНеопределено;
	Элементы.КнопкаДобавить.Доступность = ДанныеЗагружены И Свободно И Не ПрименениеНеопределено;
	Элементы.КнопкаЗагрузить.Доступность = Свободно;
	Элементы.КнопкаОптимизировать.Доступность = ДанныеЗагружены И Свободно И Не ПрименениеНеопределено;
	Элементы.КнопкаПрименить.Доступность = ДанныеЗагружены И Свободно И (ЧерновикИзменен Или ПрименениеНеопределено);
	Элементы.КнопкаОткатить.Доступность = ДанныеЗагружены И Свободно И Не ПрименениеНеопределено;
	Элементы.КнопкаСохранить.Доступность = ДанныеЗагружены И Свободно;
	Элементы.КнопкаОтменаОптимизации.Доступность = ОптимизацияВыполняется Или ЗагрузкаВыполняется;
	Элементы.КнопкаОтменаОптимизации.Видимость = ОптимизацияВыполняется Или ЗагрузкаВыполняется;
	Элементы.КнопкаОтменаОптимизации.Заголовок = "Остановить расчет";
	Если ЗагрузкаВыполняется Тогда
		Элементы.КнопкаОтменаОптимизации.Заголовок = "Отменить загрузку";
	КонецЕсли;
	Элементы.ВыборЗадания.Видимость = ДанныеЗагружены;
	Элементы.ВыборЗадания.Доступность = Свободно И Не ПрименениеНеопределено;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуHTML(Действие)

	Попытка
		Элементы.ПолеHTMLДокумента.Документ.defaultView.requestSimulatorAction(Действие);
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Принимает параметры отдельной формы и обновляет только прогноз.
// Параметры:
//  Результат - Структура, Неопределено - параметры прогноза либо отмена.
//  ДополнительныеПараметры - Произвольный - контекст оповещения формы.
&НаКлиенте
Процедура НастройкиПрогнозаЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбновитьИсторию = ИсточникДлительности <> Результат.ИсточникДлительности
		Или ДнейИстории <> Результат.ДнейИстории;
	Для Каждого Имя Из ИменаПараметровПрогноза() Цикл
		ЭтотОбъект[Имя] = Результат[Имя];
	КонецЦикла;
	Если ОбновитьИсторию И ДанныеЗагружены Тогда
		ЭтотОбъект.ИсторияТребуетОбновления = Истина;
	КонецЕсли;
	НастройкиСимуляцииПриИзменении(Неопределено);
	Если ОбновитьИсторию И ДанныеЗагружены Тогда
		ЭтотОбъект.Состояние = "Источник или период изменены. Нажмите «1. Загрузить задания» для обновления истории.";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИменаПараметровПрогноза()

	Возврат СтрРазделить("ИсточникДлительности,ДнейИстории,РежимДлительности,"
		+ "ДлительностьФиксированная,ШагГрафика,ПредлагатьЗаменуПериодаПаузой", ",");

КонецФункции

&НаКлиенте
Функция ТекстОшибкиПараметров()

	Если Не ЗначениеЗаполнено(ДатаСимуляции) Тогда
		Возврат "Укажите дату симуляции.";
	КонецЕсли;
	Если ЛимитПотоков <= 0 Или Цел(ЛимитПотоков) <> ЛимитПотоков Тогда
		Возврат "Лимит должен быть положительным целым числом.";
	КонецЕсли;
	Если ШагГрафика <> 10 И ШагГрафика <> 60 Тогда
		Возврат "Шаг графика должен быть равен 10 или 60 секундам.";
	КонецЕсли;
	Если РежимДлительности <> "Med" И РежимДлительности <> "P95" И РежимДлительности <> "Fixed" Тогда
		Возврат "Выберите вариант прогноза: обычный, с запасом или с заданной вручную длительностью.";
	КонецЕсли;
	Если ДлительностьФиксированная <= 0 Тогда
		Возврат "Укажите положительную длительность в секундах для прогноза заданий без истории.";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ПрочитатьПакет(ТекстПакета)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстПакета);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ЗаписатьПакет(ДанныеПакета)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ДанныеПакета);
	Возврат Запись.Закрыть();

КонецФункции

&НаКлиенте
Процедура ПоказатьОшибку(Текст)

	ЭтотОбъект.Состояние = Текст;
	ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
	ОбновитьДоступность();

КонецПроцедуры

&НаКлиенте
Асинх Функция СохранитьHTMLАсинх(ТекстHTML)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить автономный отчет scheduler4000";
	Диалог.Фильтр = "HTML (*.html)|*.html";
	Диалог.ПолноеИмяФайла = "scheduler4000.html";
	ВыбранныеФайлы = Ждать Диалог.ВыбратьАсинх();
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ДокументHTML = Новый ТекстовыйДокумент;
	ДокументHTML.УстановитьТекст(ТекстHTML);
	ДокументHTML.Записать(ВыбранныеФайлы[0], КодировкаТекста.UTF8);
	Возврат Истина;

КонецФункции

&НаКлиенте
Асинх Процедура СохранитьПолученныйHTMLАсинх(ТекстHTML)

	Попытка
		Сохранено = Ждать СохранитьHTMLАсинх(ТекстHTML);
		Если Сохранено Тогда
			ЭтотОбъект.Состояние = "Автономный HTML сохранен.";
		КонецЕсли;
	Исключение
		ПоказатьОшибку("Не удалось сохранить HTML: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПодтвердитьЗакрытиеАсинх()

	Попытка
		ТекстВопроса = "Закрыть форму и потерять черновик? Автоматическая запись расписаний не выполняется.";
		Если ПрименениеНеопределено Тогда
			ТекстВопроса = "Результат применения не подтвержден. Рекомендуется сначала сверить его командой применения. Закрыть форму?";
		КонецЕсли;
		Решение = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Если Решение = КодВозвратаДиалога.Да Тогда
			РазрешеноЗакрытие = Истина;
			ЭтотОбъект.Закрыть();
		КонецЕсли;
	Исключение
		ПоказатьОшибку(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
