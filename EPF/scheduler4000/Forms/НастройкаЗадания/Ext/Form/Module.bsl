&НаКлиенте
// Строка, Неопределено - пакет HTML до выхода из обработчика WebKit.
Перем ОтложенноеСообщение;
&НаКлиенте
// Булево, Неопределено - завершена первичная передача данных HTML.
Перем ДокументИнициализирован;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтотОбъект.Наименование = Параметры.Данные.Наименование;
	ЭтотОбъект.Включено = Параметры.Данные.Включено;
	ЭтотОбъект.Расписание = Параметры.Данные.Расписание;
	Обработка = РеквизитФормыВЗначение("Объект");
	Если Параметры.Данные.Свойство("ВариантыДобавления") Тогда
		ЭтотОбъект.Заголовок = "Новое регламентное задание";
		ЭтотОбъект.ВариантыДобавленияJSON = Обработка.ПакетВJSON(Параметры.Данные.ВариантыДобавления);
	КонецЕсли;
	Макет = Обработка.ПолучитьМакет("МакетHTML");
	ТекстHTML = СтрЗаменить(Макет.ПолучитьТекст(), "@@VENDOR@@", "");
	ТекстHTML = СтрЗаменить(ТекстHTML, "@@GENERATION@@", Строка(УникальныйИдентификатор));
	ЭтотОбъект.ПолеHTML = СтрЗаменить(ТекстHTML, "<body>", "<body class=""editor-document"">");
	ЭтотОбъект.ПакетJSON = ПакетРедактораНаСервере();
	ЭтотОбъект.ИсходныйПакетJSON = ПакетJSON;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеНастройкиДокументСформирован(Элемент)

	Если ДокументИнициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	Элементы.ПолеНастройки.Документ.defaultView.initJobEditor(ПакетJSON);
	ДокументИнициализирован = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПолеНастройкиПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия.Element.id <> "v8bridge" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Если ОтложенноеСообщение <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстСообщения = ДанныеСобытия.Element.getAttribute("data-payload");
	Если СтрДлина(ТекстСообщения) > 1048576 Тогда
		ВызватьИсключение "Превышен допустимый размер правок расписания.";
	КонецЕсли;
	ОтложенноеСообщение = ТекстСообщения;
	// Закрытие окна и штатный диалог выполняются после выхода из события WebKit.
	ПодключитьОбработчикОжидания("ОбработатьКомандуHTML", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает сохраненный пакет после возврата из события HTML, не скрывая DOM.
&НаКлиенте
Процедура ОбработатьКомандуHTML() Экспорт

	ТекстСообщения = ОтложенноеСообщение;
	ОтложенноеСообщение = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстСообщения);
		Сообщение = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			ВызватьИсключение "Ожидался пакет настройки задания.";
		КонецЕсли;
		Если Сообщение.event = "editorCancel" И Сообщение.Количество() = 1 Тогда
			Закрыть();
			Возврат;
		КонецЕсли;
		Если Сообщение.event <> "editorAccept" И Сообщение.event <> "editorDetailed" Тогда
			ВызватьИсключение "Неизвестная команда настройки задания.";
		КонецЕсли;
		ПринятьПравкиНаСервере(Сообщение);
		Если Сообщение.event = "editorAccept" Тогда
			Если Не ПустаяСтрока(ОписаниеНовогоЗаданияJSON) Тогда
				Результат = Новый Структура("Расписание,Включено,ОписаниеНовогоЗаданияJSON",
					Расписание, Включено, ОписаниеНовогоЗаданияJSON);
				Закрыть(Результат);
			ИначеЕсли ПакетJSON = ИсходныйПакетJSON Тогда
				Закрыть();
			Иначе
				Закрыть(Новый Структура("Расписание,Включено", Расписание, Включено));
			КонецЕсли;
		Иначе
			Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
			Диалог.Показать(Новый ОписаниеОповещения("ПодробноеРасписаниеЗавершение", ЭтотОбъект));
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Принимает результат штатного диалога только в локальную форму настройки.
// Параметры:
//  Результат - РасписаниеРегламентногоЗадания, Неопределено - новое расписание либо отмена.
//  ДополнительныеПараметры - Произвольный - параметры стандартного оповещения.
&НаКлиенте
Процедура ПодробноеРасписаниеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭтотОбъект.Расписание = Результат;
	ЭтотОбъект.ПакетJSON = ПакетРедактораНаСервере();
	Элементы.ПолеНастройки.Документ.defaultView.initJobEditor(ПакетJSON);

КонецПроцедуры

&НаСервере
Процедура ПринятьПравкиНаСервере(Знач Сообщение)

	НовоеЗадание = Не ПустаяСтрока(ВариантыДобавленияJSON);
	КоличествоПолей = ?(НовоеЗадание, 4, 3);
	Если Сообщение.Количество() <> КоличествоПолей Или Не Сообщение.Свойство("enabled")
		Или Не Сообщение.Свойство("windowChanges") Или ТипЗнч(Сообщение.enabled) <> Тип("Булево") Тогда
		ВызватьИсключение "Некорректный состав правок задания.";
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Если НовоеЗадание Тогда
		Если Не Сообщение.Свойство("creation") Тогда
			ВызватьИсключение "Не заполнено описание нового задания.";
		КонецЕсли;
		Обработка.ПроверитьОписаниеНовогоЗадания(Сообщение.creation);
		ЭтотОбъект.ОписаниеНовогоЗаданияJSON = Обработка.ПакетВJSON(Сообщение.creation);
	КонецЕсли;
	НовоеРасписание = Обработка.РасписаниеСПравкамиОкон(Расписание, Сообщение.windowChanges);
	ЭтотОбъект.Расписание = НовоеРасписание;
	ЭтотОбъект.Включено = Сообщение.enabled;
	ЭтотОбъект.ПакетJSON = ПакетРедактораНаСервере();

КонецПроцедуры

&НаСервере
Функция ПакетРедактораНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Новый Структура("id,name,enabled,schedule", "editor", Наименование, Включено,
		Обработка.РасписаниеДляКонтракта(Расписание));
	Если Не ПустаяСтрока(ВариантыДобавленияJSON) Тогда
		Данные.Вставить("creationTypes", ПрочитатьПакетРедактора(ВариантыДобавленияJSON));
		Если Не ПустаяСтрока(ОписаниеНовогоЗаданияJSON) Тогда
			Данные.Вставить("creation", ПрочитатьПакетРедактора(ОписаниеНовогоЗаданияJSON));
		КонецЕсли;
	КонецЕсли;
	Возврат Обработка.ПакетВJSON(Данные);

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьПакетРедактора(ТекстJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

#КонецОбласти
