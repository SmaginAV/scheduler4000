					</Title>
					<ContextMenu name="ПояснениеРежимаКонтекстноеМеню" id="21"/>
					<ExtendedTooltip name="ПояснениеРежимаРасширеннаяПодсказка" id="22"/>
				</LabelDecoration>
				<InputField name="ФиксированнаяДлительностьПоле" id="23">
					<DataPath>ДлительностьФиксированная</DataPath>
					<Title>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Без истории, сек</v8:content>
						</v8:item>
					</Title>
					<ToolTip>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Длительность прогноза для заданий без истории, в том числе ранее отключенных. В режимах «Обычная» и «С запасом» используется только при отсутствии измеренной длительности. В режиме «Задать вручную» используется для всех заданий. Реальное выполнение и расписание от этой настройки не меняются.</v8:content>
						</v8:item>
					</ToolTip>
					<Width>10</Width>
					<ContextMenu name="ФиксированнаяДлительностьПолеКонтекстноеМеню" id="24"/>
