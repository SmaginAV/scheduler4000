					<Width>66</Width>
					<TextColor>web:SlateGray</TextColor>
					<Title formatted="false">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Для частых заданий предложить ожидание после окончания работы. Предложение можно принять или отклонить отдельно.</v8:content>
						</v8:item>
					</Title>
					<ContextMenu name="ПояснениеПаузыКонтекстноеМеню" id="41"/>
