						<Event name="OnChange">ПараметрыПриИзменении</Event>
					</Events>
				</InputField>
				<LabelDecoration name="ПояснениеГрафика" id="34">
					<Width>66</Width>
					<TextColor>web:SlateGray</TextColor>
					<Title formatted="false">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>10 секунд — подробнее, 60 секунд — компактнее. Пик и красные зоны всегда рассчитываются точно.</v8:content>
						</v8:item>
					</Title>
					<ContextMenu name="ПояснениеГрафикаКонтекстноеМеню" id="35"/>
					<ExtendedTooltip name="ПояснениеГрафикаРасширеннаяПодсказка" id="36"/>
				</LabelDecoration>
				<CheckBoxField name="ПредлагатьПаузуПоле" id="37">
					<DataPath>ПредлагатьЗаменуПериодаПаузой</DataPath>
					<Title>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Предлагать паузу после завершения</v8:content>
						</v8:item>
					</Title>
					<ToolTip>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>После распределения запусков отдельно предложить частым заданиям паузу после завершения вместо жесткой частоты. Например, работа 20 секунд и пауза 60 секунд дают старт раз в 80 секунд. Частота изменится только после принятия предложения и сохранения в базе.</v8:content>
						</v8:item>
					</ToolTip>
					<CheckBoxType>Auto</CheckBoxType>
					<TitleLocation>Right</TitleLocation>
					<ContextMenu name="ПредлагатьПаузуПолеКонтекстноеМеню" id="38"/>
					<ExtendedTooltip name="ПредлагатьПаузуПолеРасширеннаяПодсказка" id="39"/>
					<Events>
						<Event name="OnChange">ПараметрыПриИзменении</Event>
					</Events>
				</CheckBoxField>
