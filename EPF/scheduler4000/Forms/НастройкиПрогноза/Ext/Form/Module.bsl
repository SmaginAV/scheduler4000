#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого Настройка Из Параметры.Настройки Цикл
		ЭтотОбъект[Настройка.Ключ] = Настройка.Значение;
	КонецЦикла;
	Элементы.ФиксированнаяДлительностьПоле.Заголовок = НазваниеПоляДлительности(РежимДлительности);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПараметрыПриИзменении(Элемент)

	Элементы.ФиксированнаяДлительностьПоле.Заголовок = НазваниеПоляДлительности(РежимДлительности);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрименитьНастройки(Команда)

	Если ДлительностьФиксированная <= 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите положительную длительность в секундах.");
		Возврат;
	КонецЕсли;
	Если ШагГрафика <> 10 И ШагГрафика <> 60 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Обзорный интервал должен быть 10 или 60 секунд.");
		Возврат;
	КонецЕсли;
	Если ДнейИстории <> 1 И ДнейИстории <> 2 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите глубину истории: 1 день или 2 дня.");
		Возврат;
	КонецЕсли;
	Настройки = Новый Структура;
	Настройки.Вставить("ИсточникДлительности", ИсточникДлительности);
	Настройки.Вставить("ДнейИстории", ДнейИстории);
	Настройки.Вставить("РежимДлительности", РежимДлительности);
	Настройки.Вставить("ДлительностьФиксированная", ДлительностьФиксированная);
	Настройки.Вставить("ШагГрафика", ШагГрафика);
	Настройки.Вставить("ПредлагатьЗаменуПериодаПаузой", ПредлагатьЗаменуПериодаПаузой);
	Закрыть(Настройки);

КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция НазваниеПоляДлительности(Режим)

	Если Режим = "Fixed" Тогда
		Возврат "Для всех, сек";
	КонецЕсли;
	Возврат "Без истории, сек";

КонецФункции

#КонецОбласти
